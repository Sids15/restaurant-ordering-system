---
/**
 * Kitchen board (Feature 5). The live order queue for the kitchen: confirmed
 * orders arrive here (as servers take them) and move New → Preparing → Ready →
 * served off the board. Behind the auth middleware — any staff role may view
 * and advance. Initial queue is server-rendered; the island polls for updates.
 */
import AppLayout from "../../layouts/AppLayout.astro";
import StationMasthead from "../../components/staff/StationMasthead.astro";
import StationShell from "../../components/staff/StationShell.astro";
import KitchenBoard from "../../components/order/KitchenBoard.tsx";
import AvailabilityPanel from "../../components/order/AvailabilityPanel.tsx";
import { getActiveKitchenOrders } from "../../lib/orders/kitchen";
import { getKitchenMenu } from "../../lib/menu/availability";
import { brand } from "../../data/brand";
import "../../styles/staff.css";

import { can } from "../../lib/auth/access";
export const prerender = false;

const { supabase, profile, grants } = Astro.locals;

// The 86 toggle is for kitchen + manager (the RPC enforces this too). Read
// from the grants already on locals, so deciding this costs no round trip and
// the menu fetch can start alongside the queue rather than behind it.
const canEditAvailability = can(grants, "kitchen.availability");

// Together, not one after the other: the queue and the menu have never
// depended on each other, so waiting for the first before asking for the
// second bought nothing but a second round trip on every kitchen load.
const [initialOrders, initialMenu] = await Promise.all([
  getActiveKitchenOrders(supabase),
  canEditAvailability ? getKitchenMenu(supabase) : [],
]);
---

<AppLayout title={`Kitchen — ${brand.name}`}>
  <StationShell
    role={profile!.role}
    grants={grants}
    name={profile!.name}
    pathname={Astro.url.pathname}
    counts={{ "/kitchen": initialOrders.length }}
  >
    <StationMasthead title="Kitchen board" />

    <KitchenBoard client:load initialOrders={initialOrders} canComplete={can(grants, "kitchen.view")} />

    {/* Below the board, and the board is what the kitchen is watching. Its
        markup is server-rendered either way; client:visible only defers the
        hydration, so React loads after the queue is interactive rather than
        competing with it. */}
    {canEditAvailability && <AvailabilityPanel client:visible initialMenu={initialMenu} />}
  </StationShell>
</AppLayout>
