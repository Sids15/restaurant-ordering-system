---
/**
 * Customer menu at /menu (no table) — browsing without a table, or a device
 * that already has a session (it's served its bound table). The per-table entry
 * point is /menu/[token]. A ?table= value is treated as a signed token too, so a
 * raw label no longer binds a tab (that was a spoofing vector).
 */
import AppLayout from "../../layouts/AppLayout.astro";
import MenuView from "../../components/order/MenuView.astro";
import { resolveMenuAccess } from "../../lib/orders/session";

export const prerender = false;

const urlTable = Astro.url.searchParams.get("table");
const access = await resolveMenuAccess(Astro.cookies, urlTable);
const table = access.mode === "ok" ? access.table : null;
const elsewhere = access.mode === "elsewhere" ? access.table : null;
---

<AppLayout title="Menu — Berlin">
  <MenuView table={table} elsewhere={elsewhere} />
</AppLayout>
