---
/**
 * Customer menu at /menu (no table) — browsing without a table, or a device
 * that already has a session (it's served its bound table). The per-table entry
 * point is /menu/[token]. A ?table= value is treated as a signed token too, so a
 * raw label no longer binds a tab (that was a spoofing vector).
 */
import AppLayout from "../../layouts/AppLayout.astro";
import MenuView from "../../components/order/MenuView.astro";
import { resolveMenuAccess } from "../../lib/orders/session";
import { brand } from "../../data/brand";

export const prerender = false;

const urlTable = Astro.url.searchParams.get("table");
const access = await resolveMenuAccess(Astro.cookies, urlTable);
const table = access.mode === "ok" ? access.table : null;
const elsewhere = access.mode === "elsewhere" ? access.table : null;
const invalid = access.mode === "invalid";
const errored = access.mode === "error";
---

{/* The one page in the app worth finding. Every other surface is per-guest
    (order codes, signed per-table links) or staff-only, so AppLayout's
    noindex default stands everywhere else. See src/pages/sitemap.xml.ts. */}
<AppLayout
  title={`Menu — ${brand.name}`}
  description={`${brand.tagline}. See the full menu at ${brand.name}, ${brand.contact.address.locality}.`}
  noindex={false}
>
  <MenuView table={table} elsewhere={elsewhere} invalid={invalid} errored={errored} />
</AppLayout>
