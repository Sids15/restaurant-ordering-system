---
/**
 * Customer menu for a specific table — /menu/<token>, what a table's QR encodes.
 * The segment is a SIGNED table token (not a raw label), so only a real, staff-
 * printed code opens a tab; a guessed value opens nothing. Resolving access binds
 * the device to this table's tab (httpOnly cookie) on first visit; a device
 * already bound to another open table sees a notice instead.
 */
import AppLayout from "../../layouts/AppLayout.astro";
import MenuView from "../../components/order/MenuView.astro";
import { resolveMenuAccess } from "../../lib/orders/session";

export const prerender = false;

const urlTable = Astro.params.table ?? null;
const access = await resolveMenuAccess(Astro.cookies, urlTable);
const table = access.mode === "ok" ? access.table : null;
const elsewhere = access.mode === "elsewhere" ? access.table : null;
---

<AppLayout title={table ? `Menu · Table ${table} — Berlin` : "Menu — Berlin"}>
  <MenuView table={table} elsewhere={elsewhere} />
</AppLayout>
