---
/**
 * Order tracking (Feature 3). A customer lands here right after placing an
 * order. It shows their code + QR (to show a server) and a live status that
 * flips "Waiting" → "Order placed" once a server accepts it. Server-rendered:
 * reads the order by code via the admin client (customers have no direct DB
 * access), then the OrderStatus island polls for the state change.
 */
import QRCode from "qrcode";
import AppLayout from "../../layouts/AppLayout.astro";
import OrderStatus from "../../components/order/OrderStatus.tsx";
import { getTrackedOrder } from "../../lib/orders/track";
import { formatINR } from "../../lib/money";
import { brand } from "../../data/brand";

export const prerender = false;

const code = (Astro.params.code ?? "").toUpperCase();
const order = await getTrackedOrder(code);

if (!order) {
  Astro.response.status = 404;
}

// A QR of the plain code — staff scan or key it in to pull up the order.
// Colors match the app's ink-on-paper tokens (fixed hex — QR rendering runs
// server-side and can't consume CSS custom properties).
const qrSvg = order
  ? await QRCode.toString(order.code, {
      type: "svg",
      margin: 1,
      color: { dark: "#2a2521", light: "#ffffff" },
    })
  : "";
---

<AppLayout title={order ? `Order ${order.code} — ${brand.name}` : `Order not found — ${brand.name}`}>
  {
    !order ? (
      <main class="track track--missing">
        <p class="track__eyebrow">{brand.name}</p>
        <h1 class="track__title">Order not found</h1>
        <p class="track__note">
          We couldn't find an order for that code. Please check it, or place a new
          order from the menu.
        </p>
        <a class="track__link" href="/menu">Back to the menu</a>
      </main>
    ) : (
      <main class="track">
        <header class="track__head">
          <p class="track__eyebrow">{brand.name}</p>
          <h1 class="track__title">Your order</h1>
          <p class="track__sub">Keep this ticket until your order reaches the table.</p>
          {order.table_label && <p class="track__table">Table {order.table_label}</p>}
        </header>

        <OrderStatus client:load code={order.code} initialState={order.state} />

        <section class="pass" aria-label="Your order code">
          <div class="pass__qr" set:html={qrSvg} />
          <div class="pass__meta">
            <p class="pass__label">Order code</p>
            <p class="pass__code">{order.code}</p>
            <p class="pass__hint">Show this to a server to confirm your order.</p>
          </div>
        </section>

        <section class="summary" aria-label="Order summary">
          <h2 class="summary__title">Summary</h2>
          <ul class="summary__list">
            {order.items.map((line) => (
              <li class="summary__line">
                <span class="summary__qty">{line.qty}×</span>
                <span class="summary__name">{line.name}</span>
                <span class="summary__price">{formatINR(line.price * line.qty)}</span>
              </li>
            ))}
          </ul>
          <div class="summary__total">
            <span>Subtotal</span>
            <span>{formatINR(order.subtotal)}</span>
          </div>
          {order.notes && <p class="summary__notes">Note — {order.notes}</p>}
        </section>

        <nav class="track__links" aria-label="More">
          <a class="track__link" href="/orders">
            <span>See all your orders</span>
            <svg width="30" height="8" viewBox="0 0 30 8" fill="none" aria-hidden="true">
              <path d="M0 4h28M28 4l-5-3.25M28 4l-5 3.25" stroke="currentColor" stroke-width="1" stroke-linecap="square" />
            </svg>
          </a>
          <a
            class="track__link"
            href={order.table_label ? `/menu/${encodeURIComponent(order.table_label)}` : "/menu"}
          >
            <span>Order something more</span>
            <svg width="30" height="8" viewBox="0 0 30 8" fill="none" aria-hidden="true">
              <path d="M0 4h28M28 4l-5-3.25M28 4l-5 3.25" stroke="currentColor" stroke-width="1" stroke-linecap="square" />
            </svg>
          </a>
        </nav>
      </main>
    )
  }
</AppLayout>

<style>
  .track {
    max-width: var(--container-md);
    margin-inline: auto;
    padding: clamp(var(--space-40), 8vw, var(--space-64)) var(--gutter) var(--space-64);
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .track--missing {
    min-height: 100svh;
    justify-content: center;
    text-align: center;
    gap: var(--space-16);
  }
  .track__head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .track__eyebrow {
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .track__title {
    margin-block-start: var(--space-8);
    color: var(--ink);
  }
  .track__sub {
    margin: var(--space-8) auto 0;
    max-width: 24rem;
    color: var(--ink-muted);
  }
  .track__table {
    display: inline-flex;
    margin-block-start: var(--space-16);
    padding: var(--space-4) var(--space-12);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius-pill);
  }
  .track__note {
    margin: 0 auto;
    color: var(--ink-muted);
  }

  /* --- Status banner (OrderStatus island) -------------------------------- */
  .track :global(.status) {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding: var(--space-24);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .track :global(.status__chip) {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-8) var(--space-16);
    font-size: var(--fs-caption);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    border-radius: var(--radius-pill);
  }
  .track :global(.status__chip--pending) {
    color: var(--status-pending);
    background: var(--status-pending-soft);
  }
  .track :global(.status__chip--confirmed) {
    color: var(--status-confirmed);
    background: var(--status-confirmed-soft);
  }
  .track :global(.status__chip--cancelled) {
    color: var(--danger);
    background: var(--danger-soft);
  }
  .track :global(.status__dot) {
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }
  .track :global(.status__chip--pending .status__dot) {
    animation: pulse 1.6s var(--ease-out) infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.7);
    }
  }
  .track :global(.status__note) {
    font-size: var(--fs-body);
    color: var(--ink-muted);
  }

  /* --- Milestone stepper (waiting → placed) ------------------------------- */
  .track :global(.status__steps) {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    margin-block-start: var(--space-4);
  }
  .track :global(.status__step) {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    font-size: var(--fs-caption);
    font-weight: 500;
    color: var(--ink-muted);
  }
  .track :global(.status__step)::before {
    content: "";
    flex: 1 1 2rem;
    order: -1;
    height: 1px;
    background: var(--border-strong);
    margin-inline-end: var(--space-8);
  }
  .track :global(.status__step:first-child)::before {
    display: none;
    margin-inline-end: 0;
  }
  .track :global(.status__step-dot) {
    flex: 0 0 auto;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: 1.5px solid var(--border-strong);
    background: var(--surface-raised);
  }
  .track :global(.status__step.is-done .status__step-dot) {
    border-color: var(--status-confirmed);
    background: var(--status-confirmed);
  }
  .track :global(.status__step.is-done) {
    color: var(--ink);
  }

  /* --- Pass (code + QR) ---------------------------------------------------- */
  .pass {
    display: flex;
    align-items: center;
    gap: var(--space-24);
    padding: var(--space-24);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .pass__qr {
    flex: 0 0 auto;
    width: 7rem;
    height: 7rem;
    padding: var(--space-8);
    /* design-lint: allow-raw-color - the QR's quiet zone stays pure white so a
       retheme can't tint it below scanning contrast. */
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .pass__qr :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .pass__label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .pass__code {
    margin-block-start: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--fs-heading-l);
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--ink);
  }
  .pass__hint {
    margin-block-start: var(--space-8);
    font-size: var(--fs-caption);
    color: var(--ink-muted);
  }

  /* --- Summary ------------------------------------------------------------ */
  .summary {
    padding: var(--space-24);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .summary__title {
    color: var(--ink);
    padding-block-end: var(--space-16);
    border-bottom: 1px solid var(--border);
  }
  .summary__list {
    display: flex;
    flex-direction: column;
  }
  .summary__line {
    display: flex;
    align-items: baseline;
    gap: var(--space-16);
    padding-block: var(--space-12);
    border-bottom: 1px solid var(--border);
  }
  .summary__line:last-child {
    border-bottom: none;
  }
  .summary__qty {
    flex: 0 0 auto;
    color: var(--accent);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .summary__name {
    flex: 1 1 auto;
    color: var(--ink);
  }
  .summary__price {
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .summary__total {
    display: flex;
    justify-content: space-between;
    padding-block-start: var(--space-16);
    font-size: var(--fs-body-l);
    font-weight: 600;
    color: var(--ink);
  }
  .summary__total span:last-child {
    font-variant-numeric: tabular-nums;
  }
  .summary__notes {
    margin-block-start: var(--space-12);
    font-size: var(--fs-caption);
    color: var(--ink-muted);
  }

  .track__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-16) var(--space-32);
  }
  .track__link {
    min-height: var(--tap);
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--accent);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .track__link svg {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .track__link:hover {
    color: var(--accent-hover);
  }
  .track__link:hover svg {
    transform: translateX(4px);
  }
  .track--missing .track__link {
    align-self: center;
    margin-block-start: var(--space-16);
  }

  @media (max-width: 36rem) {
    .pass {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
