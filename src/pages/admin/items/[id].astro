---
/**
 * Edit a dish (manager). Shared DishForm posts to /api/admin/items/[id]; a
 * separate form deletes it (kept out of the edit form since forms can't nest).
 */
import AppLayout from "../../../layouts/AppLayout.astro";
import StationMasthead from "../../../components/staff/StationMasthead.astro";
import DishForm from "../../../components/order/DishForm.astro";
import { getItem, getCategoryOptions } from "../../../lib/menu/admin";
import { brand } from "../../../data/brand";
import "../../../styles/staff.css";

export const prerender = false;

const { supabase } = Astro.locals;
const id = Astro.params.id ?? "";
const item = await getItem(supabase, id);
if (!item) Astro.response.status = 404;

const categories = item ? await getCategoryOptions(supabase) : [];
const err = Astro.url.searchParams.get("err");
---

<AppLayout title={item ? `Edit ${item.name} — ${brand.name}` : `Dish not found — ${brand.name}`}>
  <main class="st-shell admin-form">
    <StationMasthead eyebrow={`${brand.name} · Manager`} title={item ? "Edit dish" : "Dish not found"}>
      <a class="st-back" slot="actions" href="/admin">
        <span aria-hidden="true">←</span> Menu manager
      </a>
    </StationMasthead>

    {err && <p class="st-alert st-alert--error" role="alert">{err}</p>}

    {!item ? (
      <p class="st-empty">That dish no longer exists.</p>
    ) : (
      <>
        <DishForm
          item={item}
          categories={categories}
          action={`/api/admin/items/${id}`}
          submitLabel="Save changes"
          isEdit
        />
        <form method="post" action={`/api/admin/items/${id}`} class="delete">
          <input type="hidden" name="action" value="delete" />
          <button type="submit" class="delete__btn">Delete dish</button>
        </form>
      </>
    )}
  </main>
</AppLayout>

<style>
  .admin-form {
    max-width: var(--container-md);
  }
  .delete {
    padding-block-start: var(--space-16);
    border-top: 1px solid var(--border);
  }
  .delete__btn {
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--ink-muted);
    font: inherit;
    font-weight: 600;
    min-height: var(--field-height);
    padding-inline: var(--space-24);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .delete__btn:hover {
    color: var(--danger);
    border-color: var(--danger);
  }
</style>
