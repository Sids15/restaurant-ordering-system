---
/**
 * Add a dish (manager). Renders the shared DishForm; posts to
 * /api/admin/items/new.
 */
import AppLayout from "../../../layouts/AppLayout.astro";
import StationMasthead from "../../../components/staff/StationMasthead.astro";
import DishForm from "../../../components/order/DishForm.astro";
import { getCategoryOptions } from "../../../lib/menu/admin";
import { brand } from "../../../data/brand";
import "../../../styles/staff.css";

export const prerender = false;

const { supabase } = Astro.locals;
const categories = await getCategoryOptions(supabase);
const err = Astro.url.searchParams.get("err");
---

<AppLayout title={`Add dish — ${brand.name}`}>
  <main class="st-shell admin-form">
    <StationMasthead eyebrow={`${brand.name} · Manager`} title="Add a dish">
      <a class="st-back" slot="actions" href="/admin">
        <span aria-hidden="true">←</span> Menu manager
      </a>
    </StationMasthead>

    {err && <p class="st-alert st-alert--error" role="alert">{err}</p>}

    {categories.length === 0 ? (
      <p class="st-empty">Create a category first — then you can add dishes to it.</p>
    ) : (
      <DishForm categories={categories} action="/api/admin/items/new" submitLabel="Add dish" />
    )}
  </main>
</AppLayout>

<style>
  .admin-form {
    max-width: var(--container-md);
  }
</style>
