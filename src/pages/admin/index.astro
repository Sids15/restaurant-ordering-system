---
/**
 * Manager menu panel (Feature 6). Manager-only (role-gated by the middleware).
 * Lists every dish by category with edit/delete; add a new dish. Category CRUD
 * lands next. Writes go through the authenticated client — RLS enforces manager.
 */
import AppLayout from "../../layouts/AppLayout.astro";
import StationMasthead from "../../components/staff/StationMasthead.astro";
import StationShell from "../../components/staff/StationShell.astro";
import { getAdminMenu } from "../../lib/menu/admin";
import { formatINR } from "../../lib/money";
import { brand } from "../../data/brand";
import "../../styles/staff.css";
import "../../styles/order-builder.css";

export const prerender = false;

const { supabase, profile } = Astro.locals;
const menu = await getAdminMenu(supabase);

const params = Astro.url.searchParams;
const ok = params.get("ok"); // created | saved | deleted
const err = params.get("err");
const OK_COPY: Record<string, string> = {
  created: "Dish created.",
  saved: "Dish saved.",
  deleted: "Dish deleted.",
  "cat-created": "Category created.",
  "cat-saved": "Category saved.",
  "cat-deleted": "Category deleted.",
};
---

<AppLayout title={`Menu manager — ${brand.name}`}>
  <StationShell role={profile!.role} name={profile!.name} pathname={Astro.url.pathname}>
    <StationMasthead eyebrow={`${brand.name} · Manager`} title="Menu manager">
      <a class="st-cta" slot="actions" href="/admin/items/new">
        <span aria-hidden="true">+</span> Add dish
      </a>
    </StationMasthead>

    {(ok || err) && (
      <div class="toaster" aria-live="polite">
        {ok && <p class="toast toast--ok" data-toast data-ttl="3200">{OK_COPY[ok] ?? "Done."}</p>}
        {err && <p class="toast toast--err" role="alert" data-toast data-ttl="6000">{err}</p>}
      </div>
    )}

    {menu.length === 0 ? (
      <p class="st-empty">No categories yet. Category management is coming next.</p>
    ) : (
      menu.map((cat) => (
        <section class="cat">
          <h2 class="cat__name">{cat.name}</h2>
          {cat.items.length === 0 ? (
            <p class="cat__empty">No dishes in this category.</p>
          ) : (
            <ul class="cat__list">
              {cat.items.map((i) => (
                <li class={`drow ${i.is_available ? "" : "drow--off"}`}>
                  <span class={`vegdot vegdot--${i.veg_type}`} aria-hidden="true" />
                  <span class="drow__name">
                    {i.name}
                    {i.is_signature && <span class="drow__sig">Signature</span>}
                    {!i.is_available && <span class="drow__off">86'd</span>}
                  </span>
                  <span class="drow__price">{formatINR(i.price)}</span>
                  <a class="drow__edit" href={`/admin/items/${i.id}`}>Edit</a>
                  <form method="post" action={`/api/admin/items/${i.id}`} class="drow__delform">
                    <input type="hidden" name="action" value="delete" />
                    <button type="submit" class="drow__del">Delete</button>
                  </form>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    )}

    <section class="cats">
      <h2 class="cats__title">Categories</h2>
      <ul class="cats__list">
        {menu.map((c) => (
          <li class="crow">
            <form class="crow__edit" method="post" action={`/api/admin/categories/${c.id}`}>
              <input type="hidden" name="action" value="update" />
              <input class="crow__name" type="text" name="name" value={c.name} aria-label="Category name" />
              <input class="crow__sort" type="number" name="sort_order" value={c.sort_order} aria-label="Sort order" />
              <button class="crow__save" type="submit">Save</button>
            </form>
            <span class="crow__count">{c.items.length} {c.items.length === 1 ? "dish" : "dishes"}</span>
            <form method="post" action={`/api/admin/categories/${c.id}`}>
              <input type="hidden" name="action" value="delete" />
              <button class="crow__del" type="submit" disabled={c.items.length > 0}
                title={c.items.length > 0 ? "Move or delete its dishes first" : "Delete category"}>
                Delete
              </button>
            </form>
          </li>
        ))}
      </ul>

      <form class="catnew" method="post" action="/api/admin/categories/new">
        <input class="crow__name" type="text" name="name" placeholder="New category name" required />
        <input class="crow__sort" type="number" name="sort_order" value={menu.length} aria-label="Sort order" />
        <button class="catnew__add" type="submit">+ Add category</button>
      </form>
    </section>
  </StationShell>
</AppLayout>

<script>
  // Auto-dismiss each toast after its TTL, then clean the ?ok/?err from the URL
  // so a refresh doesn't replay the message.
  for (const el of document.querySelectorAll<HTMLElement>("[data-toast]")) {
    const ttl = Number(el.dataset.ttl) || 3200;
    window.setTimeout(() => {
      el.classList.add("toast--hide");
      el.addEventListener("animationend", () => el.remove(), { once: true });
    }, ttl);
  }
  if (location.search) {
    history.replaceState(null, "", location.pathname);
  }
</script>

<style>
  /* --- Toast — rises from the bottom, then dismisses itself. --------------- */
  .toaster {
    position: fixed;
    inset-block-end: calc(var(--space-32) + env(safe-area-inset-bottom, 0px));
    inset-inline: 0;
    z-index: var(--z-overlay);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    padding-inline: var(--gutter);
    pointer-events: none;
  }
  .toast {
    pointer-events: auto;
    max-width: min(32rem, 92vw);
    padding: var(--space-16) var(--space-24);
    font-size: var(--fs-caption);
    color: var(--ink);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-inline-start: 3px solid var(--accent);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    animation: toast-in 0.5s var(--ease-out) both;
  }
  .toast--ok {
    border-inline-start-color: var(--status-ready);
  }
  .toast--err {
    border-inline-start-color: var(--danger);
  }
  .toast--hide {
    animation: toast-out 0.4s var(--ease-out) forwards;
  }
  @keyframes toast-in {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes toast-out {
    to { opacity: 0; transform: translateY(18px); }
  }

  /* --- Category card — a bordered surface holding its dish rows ------------ */
  .cat {
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    padding: var(--space-24);
  }
  .cat__name {
    font-family: var(--font-display);
    font-size: var(--fs-heading-m);
    color: var(--ink);
    padding-block-end: var(--space-12);
    border-bottom: 1px solid var(--border);
  }
  .cat__empty {
    padding-block: var(--space-16);
    color: var(--ink-muted);
    font-size: var(--fs-caption);
  }
  .cat__list {
    display: flex;
    flex-direction: column;
  }
  .drow {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .drow:last-child {
    border-bottom: none;
    padding-block-end: 0;
  }
  .drow__name {
    flex: 1 1 auto;
    min-width: 0;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
  }
  .drow--off .drow__name {
    color: var(--ink-muted);
  }
  .drow__sig {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius-pill);
    padding: 2px var(--space-8);
  }
  .drow__off {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--danger);
    background: var(--danger-soft);
    border-radius: var(--radius-pill);
    padding: 2px var(--space-8);
  }
  .drow__price {
    flex: 0 0 auto;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--ink);
  }
  .drow__edit {
    flex: 0 0 auto;
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--accent);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .drow__edit:hover {
    color: var(--accent-hover);
  }
  .drow__del {
    flex: 0 0 auto;
    background: none;
    border: none;
    font: inherit;
    font-size: var(--fs-caption);
    color: var(--ink-muted);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .drow__del:hover {
    color: var(--danger);
  }

  /* --- Categories management ------------------------------------------------ */
  .cats {
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    padding: var(--space-24);
  }
  .cats__title {
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    padding-block-end: var(--space-16);
  }
  .cats__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .crow {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    flex-wrap: wrap;
  }
  .crow__edit,
  .catnew {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
  .catnew {
    margin-block-start: var(--space-16);
    padding-block-start: var(--space-16);
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .crow__name,
  .crow__sort {
    padding: var(--space-8) var(--space-12);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--ink);
    font: inherit;
    /* ≥16px so iOS doesn't zoom-and-reflow on focus (body font is 15px). */
    font-size: max(1rem, var(--fs-body));
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .crow__sort {
    width: 4.5rem;
  }
  .crow__name:focus-visible,
  .crow__sort:focus-visible {
    outline: none;
    border-color: var(--accent);
  }
  .crow__save,
  .crow__del {
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--ink-muted);
    font: inherit;
    font-size: var(--fs-caption);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    padding: var(--space-8) var(--space-16);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .crow__save:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
  .crow__del:hover:not(:disabled) {
    color: var(--danger);
    border-color: var(--danger);
  }
  .crow__del:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .crow__count {
    font-size: var(--fs-caption);
    color: var(--ink-muted);
  }
  .catnew__add {
    background: var(--accent);
    color: var(--on-accent);
    border: none;
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--fs-caption);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    padding: var(--space-8) var(--space-24);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .catnew__add:hover {
    background: var(--accent-hover);
  }
</style>
