---
/**
 * Today — the manager's view of a trading day: what was taken, which tabs are
 * still open, and which closed. Manager only (lib/auth/access.ts).
 *
 * `?date=YYYY-MM-DD` looks at another day; the boundary is resolved in the
 * restaurant's timezone, not the server's (lib/orders/day.ts).
 */
import AppLayout from "../../layouts/AppLayout.astro";
import StationMasthead from "../../components/staff/StationMasthead.astro";
import StationShell from "../../components/staff/StationShell.astro";
import {
  dayRange,
  dayLabel,
  localDateKey,
  monthRange,
  monthKeyOf,
  monthLabel,
  monthGrid,
  shiftMonth,
} from "../../lib/orders/day";
import { getDaySummary, getMonthActivity } from "../../lib/orders/manager";
import { assigneeName } from "../../lib/orders/assign";
import { formatINR } from "../../lib/money";
import { brand } from "../../data/brand";
import "../../styles/staff.css";

export const prerender = false;

const { supabase, profile } = Astro.locals;
if (profile!.role !== "manager") return Astro.redirect("/staff", 302);

const range = dayRange(Astro.url.searchParams.get("date") ?? undefined);
const day = await getDaySummary(supabase, range);
const label = dayLabel(range.key);

const today = localDateKey();
const shift = (days: number): string => {
  const [y, m, d] = range.key.split("-").map(Number);
  const at = new Date(Date.UTC(y, m - 1, d + days, 12));
  return at.toISOString().slice(0, 10);
};
const prevKey = shift(-1);
const nextKey = shift(1);
const atToday = range.key === today;

// --- The day picker -------------------------------------------------------
// `?month=` decides which month the picker shows, independently of `?date=`.
// Paging months is therefore a plain link, and its presence is what holds the
// popover open across the reload — so month navigation needs no JavaScript.
const monthParam = Astro.url.searchParams.get("month");
const viewMonth = monthParam && /^\d{4}-\d{2}$/.test(monthParam) ? monthParam : monthKeyOf(range.key);
const cells = monthGrid(viewMonth);
const activity = await getMonthActivity(supabase, monthRange(viewMonth));
const thisMonth = monthKeyOf(today);

/** Page the calendar without losing the day you are looking at. */
const monthHref = (key: string) => `/staff/today?date=${range.key}&month=${key}`;
const WEEKDAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

function clock(iso: string): string {
  return new Date(iso).toLocaleTimeString("en-IN", {
    timeZone: brand.timezone,
    hour: "2-digit",
    minute: "2-digit",
  });
}

/** "3 Sept, 01:36" — for a tab that opened on an earlier day, where a bare
 *  time would read as this morning. */
function stamp(iso: string): string {
  const d = new Date(iso);
  const day = d.toLocaleDateString("en-IN", {
    timeZone: brand.timezone,
    day: "numeric",
    month: "short",
  });
  return `${day}, ${clock(iso)}`;
}
---

<AppLayout title={`Today — ${brand.name}`}>
  <StationShell
    role={profile!.role}
    name={profile!.name}
    pathname={Astro.url.pathname}
    counts={{ "/staff/today": day.openTabs.length }}
  >
    <StationMasthead title={label}>
      <div class="daynav" slot="actions">
        <a class="daynav__step" href={`/staff/today?date=${prevKey}`} rel="prev">
          <span aria-hidden="true">←</span>
          <span class="visually-hidden">Previous day</span>
        </a>

        <details class="cal" open={Boolean(monthParam)}>
          <summary class="cal__toggle">
            <span>Pick a day</span>
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </summary>

          <div class="cal__pop">
            <div class="cal__head">
              <a class="cal__month-step" href={monthHref(shiftMonth(viewMonth, -1))}>
                <span aria-hidden="true">←</span>
                <span class="visually-hidden">Previous month</span>
              </a>
              <span class="cal__month">{monthLabel(viewMonth)}</span>
              <a
                class="cal__month-step"
                href={viewMonth >= thisMonth ? undefined : monthHref(shiftMonth(viewMonth, 1))}
                aria-disabled={viewMonth >= thisMonth ? "true" : undefined}
              >
                <span aria-hidden="true">→</span>
                <span class="visually-hidden">Next month</span>
              </a>
            </div>

            <div class="cal__grid" role="presentation">
              {WEEKDAYS.map((d) => <span class="cal__dow">{d}</span>)}
              {
                cells.map((c) => {
                  const took = activity.get(c.key);
                  const label = took
                    ? `${dayLabel(c.key)} — ${formatINR(took.takings)} from ${took.orders} ${took.orders === 1 ? "order" : "orders"}`
                    : `${dayLabel(c.key)} — nothing taken`;
                  return c.future ? (
                    <span class="cal__day cal__day--off" aria-hidden="true">{c.day}</span>
                  ) : (
                    <a
                      class:list={[
                        "cal__day",
                        !c.inMonth && "cal__day--outside",
                        c.today && "cal__day--today",
                        c.key === range.key && "cal__day--on",
                      ]}
                      href={`/staff/today?date=${c.key}`}
                      aria-current={c.key === range.key ? "date" : undefined}
                      aria-label={label}
                      title={label}
                    >
                      {c.day}
                      {took && <span class="cal__dot" aria-hidden="true"></span>}
                    </a>
                  );
                })
              }
            </div>

            <a class="cal__jump" href="/staff/today">Jump to today</a>
          </div>
        </details>

        {!atToday && <a class="daynav__today" href="/staff/today">Today</a>}
        <a
          class="daynav__step"
          href={atToday ? undefined : `/staff/today?date=${nextKey}`}
          aria-disabled={atToday ? "true" : undefined}
          rel="next"
        >
          <span aria-hidden="true">→</span>
          <span class="visually-hidden">Next day</span>
        </a>
      </div>
    </StationMasthead>

    {/* The shift in one line. Takings lead because it is the number a manager
        opens this page for; everything else qualifies it. */}
    <section class="tally st-rise" aria-label="Day summary">
      <div class="tally__cell tally__cell--lead">
        <p class="tally__label">Takings</p>
        <p class="tally__value">{formatINR(day.totals.takings)}</p>
      </div>
      <div class="tally__cell">
        <p class="tally__label">Orders</p>
        <p class="tally__value">
          {day.totals.orderCount}
          {day.totals.cancelledCount > 0 && (
            <span class="tally__sub">{day.totals.cancelledCount} cancelled</span>
          )}
        </p>
      </div>
      <div class="tally__cell">
        <p class="tally__label">Open tabs</p>
        <p class="tally__value">
          {day.openTabs.length}
          {day.totals.openValue > 0 && (
            <span class="tally__sub">{formatINR(day.totals.openValue)} unbilled</span>
          )}
        </p>
      </div>
      <div class="tally__cell">
        <p class="tally__label">Closed</p>
        <p class="tally__value">
          {day.closedTabs.length}
          {day.totals.closedValue > 0 && (
            <span class="tally__sub">{formatINR(day.totals.closedValue)}</span>
          )}
        </p>
      </div>
    </section>

    <section class="st-rise-2" aria-labelledby="tabs-h">
      <h2 class="sec__title" id="tabs-h">Tabs</h2>
      {day.openTabs.length === 0 && day.closedTabs.length === 0 ? (
        <p class="st-empty">No tabs opened on this day.</p>
      ) : (
        <ul class="rows">
          {day.openTabs.map((t) => (
            <li class="row">
              <a class="row__main" href={`/staff/tabs/${t.id}`}>
                <span class="row__title">Table {t.table_label}</span>
                <span class="row__meta">
                  {t.carried
                    ? `Open since ${stamp(t.opened_at)}`
                    : `Opened ${clock(t.opened_at)}`} · {t.order_count}{" "}
                  {t.order_count === 1 ? "round" : "rounds"}
                  {t.assigned && <> · {assigneeName(t.assigned)}</>}
                </span>
              </a>
              <span class="row__amount">{formatINR(t.subtotal)}</span>
              <span class="pill pill--accent tag">Open</span>
            </li>
          ))}
          {day.closedTabs.map((t) => (
            <li class="row">
              <a class="row__main" href={`/staff/tabs/${t.id}`}>
                <span class="row__title">Table {t.table_label}</span>
                <span class="row__meta">
                  {clock(t.opened_at)}–{t.closed_at ? clock(t.closed_at) : "—"} ·{" "}
                  {t.order_count} {t.order_count === 1 ? "round" : "rounds"}
                  {t.assigned && <> · {assigneeName(t.assigned)}</>}
                </span>
              </a>
              <span class="row__amount">{formatINR(t.subtotal)}</span>
              <span class="pill tag">Closed</span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="st-rise-2" aria-labelledby="orders-h">
      <h2 class="sec__title" id="orders-h">Orders</h2>
      {day.orders.length === 0 ? (
        <p class="st-empty">No orders on this day.</p>
      ) : (
        <ul class="rows">
          {day.orders.map((o) => (
            <li class={`row ${o.status === "cancelled" ? "row--void" : ""}`}>
              <a class="row__main" href={`/staff?code=${o.code}`}>
                <span class="row__title">{o.code}</span>
                <span class="row__meta">
                  {clock(o.created_at)} ·{" "}
                  {o.table_label ? `Table ${o.table_label}` : "No table"} ·{" "}
                  {o.source === "customer" ? "Guest" : "Server"}
                  {/* A void is the one action that makes money disappear, so
                      the day view says who did it. */}
                  {o.status === "cancelled" && (
                    <span class="row__void">
                      {o.cancelled_by
                        ? ` · voided by ${assigneeName(o.cancelled_by)}`
                        : " · voided (author not recorded)"}
                    </span>
                  )}
                </span>
              </a>
              <span class="row__amount">{formatINR(o.subtotal)}</span>
              <span class={`pill pill--${o.status} tag`}>{o.status}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  </StationShell>
</AppLayout>

<script>
  // Progressive enhancement: the picker opens, pages months and selects a day
  // with JavaScript off. This only closes it the ways people expect.
  const cal = document.querySelector<HTMLDetailsElement>(".cal");
  if (cal) {
    document.addEventListener("click", (e) => {
      if (cal.open && !cal.contains(e.target as Node)) cal.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && cal.open) {
        cal.open = false;
        cal.querySelector<HTMLElement>(".cal__toggle")?.focus();
      }
    });
  }
</script>

<style>
  .daynav {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
  .daynav__step,
  .daynav__today {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: var(--tap);
    padding-inline: var(--space-12);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--ink-muted);
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .daynav__step:hover,
  .daynav__today:hover {
    color: var(--ink);
    border-color: var(--ink-muted);
  }
  .daynav__step[aria-disabled="true"] {
    opacity: 0.35;
    pointer-events: none;
  }

  /* --- Day picker ---------------------------------------------------------
     A <details> popover: month paging is a link carrying ?month=, and that
     parameter is what re-opens the panel after the reload, so the whole thing
     works with JavaScript off. The script below only adds the conveniences
     (click-away, Escape). */
  .cal {
    position: relative;
  }
  .cal__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: var(--tap);
    padding-inline: var(--space-16);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .cal__toggle::-webkit-details-marker {
    display: none;
  }
  .cal__toggle:hover {
    color: var(--ink);
    border-color: var(--ink-muted);
  }
  .cal[open] .cal__toggle {
    color: var(--ink);
    border-color: var(--accent);
  }
  .cal[open] .cal__toggle svg {
    transform: rotate(180deg);
  }
  .cal__toggle svg {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .cal__pop {
    position: absolute;
    z-index: var(--z-overlay);
    inset-block-start: calc(100% + var(--space-8));
    inset-inline-end: 0;
    width: 20rem;
    padding: var(--space-16);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
  }

  .cal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    margin-block-end: var(--space-12);
  }
  .cal__month {
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
    color: var(--ink);
  }
  .cal__month-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    min-height: 2rem;
    border-radius: var(--radius-sm);
    color: var(--ink-muted);
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .cal__month-step:hover {
    color: var(--ink);
    background: var(--surface-sunken);
  }
  .cal__month-step[aria-disabled="true"] {
    opacity: 0.3;
    pointer-events: none;
  }

  .cal__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
  }
  .cal__dow {
    padding-block-end: var(--space-8);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
    text-align: center;
  }
  .cal__day {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
    font-size: var(--fs-caption);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .cal__day:hover {
    background: var(--surface-sunken);
  }
  .cal__day--outside {
    color: var(--ink-muted);
    opacity: 0.55;
  }
  /* Days that haven't happened. Rendered, not omitted, so the grid keeps its
     shape and the week columns stay aligned. */
  .cal__day--off {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    font-size: var(--fs-caption);
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
    opacity: 0.25;
  }
  .cal__day--today {
    font-weight: 700;
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }
  .cal__day--on,
  .cal__day--on:hover {
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }

  /* Presence, not amount: the calendar's job is navigation, and 42 squares of
     currency would be a wall. The figure is on the square's label instead. */
  .cal__dot {
    position: absolute;
    inset-block-end: 4px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
  }
  .cal__day--on .cal__dot {
    background: var(--on-accent);
  }

  .cal__jump {
    display: block;
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-12);
    border-top: 1px solid var(--border);
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--accent);
    text-align: center;
  }

  @media (max-width: 36rem) {
    .cal__pop {
      width: min(20rem, calc(100vw - 2 * var(--gutter)));
    }
  }

  /* Summary strip. Takings gets the display face and twice the size — it is the
     one figure worth reading from across a desk. */
  .tally {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-16);
    padding: var(--space-24);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .tally__label {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .tally__value {
    margin-block-start: var(--space-4);
    font-size: var(--fs-heading-s);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .tally__cell--lead .tally__value {
    font-family: var(--font-display);
    font-size: var(--fs-heading-l);
    font-weight: 400;
    line-height: var(--lh-heading);
  }
  .tally__sub {
    display: block;
    margin-block-start: 2px;
    font-family: var(--font-ui);
    font-size: var(--fs-caption);
    font-weight: 500;
    color: var(--ink-muted);
  }

  .sec__title {
    margin-block-end: var(--space-12);
    color: var(--ink);
  }

  .rows {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    min-height: 3.5rem;
    padding: var(--space-8) var(--space-16);
    background: var(--surface-raised);
    border-bottom: 1px solid var(--border);
  }
  .row:last-child {
    border-bottom: 0;
  }
  .row__main {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .row__title {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--ink);
  }
  .row__meta {
    font-size: var(--fs-caption);
    color: var(--ink-muted);
  }
  .row__amount {
    flex: 0 0 auto;
    font-size: var(--fs-body);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .row__void {
    color: var(--danger);
    font-weight: 600;
  }
  .row--void .row__title,
  .row--void .row__amount {
    color: var(--ink-muted);
    text-decoration: line-through;
  }

  /* The status column lines up down the list, so the pills share a width. */
  .tag {
    min-width: 5.5rem;
  }

  @media (max-width: 48rem) {
    .row {
      flex-wrap: wrap;
    }
    .row__main {
      flex-basis: 100%;
    }
  }
</style>
