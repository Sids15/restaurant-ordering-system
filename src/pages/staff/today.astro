---
/**
 * Today — the manager's view of trading: what was taken, which tabs are still
 * open, and which closed. Manager only (lib/auth/access.ts).
 *
 * The period comes from the URL and defaults to today; a day and a range are
 * the same shape downstream (lib/orders/period.ts). All boundaries resolve in
 * the restaurant's timezone, not the server's — Vercel runs UTC, 5:30 out.
 */
import AppLayout from "../../layouts/AppLayout.astro";
import StationMasthead from "../../components/staff/StationMasthead.astro";
import StationShell from "../../components/staff/StationShell.astro";
import PeriodPicker from "../../components/staff/PeriodPicker.astro";
import { dayLabel, monthRange } from "../../lib/orders/day";
import { can } from "../../lib/auth/access";
import { resolvePeriod } from "../../lib/orders/period";
import { getDaySummary, getDailyTotals } from "../../lib/orders/manager";
import { assigneeName } from "../../lib/orders/assign";
import { formatINR } from "../../lib/money";
import { brand } from "../../data/brand";
import "../../styles/staff.css";

export const prerender = false;

const { supabase, profile, grants } = Astro.locals;
if (!can(grants, "reports.day")) return Astro.redirect("/staff", 302);

const sel = resolvePeriod(Astro.url, "/staff/today");
const { isRange, from, to, span, label } = sel;

const day = await getDaySummary(supabase, sel.period);
const activity = await getDailyTotals(supabase, monthRange(sel.viewMonth));

// A range gets its days, not its individual rounds: thirty days of rounds is a
// wall, thirty daily figures is a report you can read.
const breakdown = isRange
  ? [...(await getDailyTotals(supabase, sel.period)).entries()]
      .sort((a, b) => (a[0] < b[0] ? 1 : -1))
      .map(([key, v]) => ({ key, ...v }))
  : [];
const bestDay = breakdown.reduce(
  (best, d) => (best === null || d.takings > best.takings ? d : best),
  null as (typeof breakdown)[number] | null,
);

function clock(iso: string): string {
  return new Date(iso).toLocaleTimeString("en-IN", {
    timeZone: brand.timezone,
    hour: "2-digit",
    minute: "2-digit",
  });
}

/** "3 Sept, 01:36" — for a tab that opened before the period being viewed. */
function stamp(iso: string): string {
  const dayPart = new Date(iso).toLocaleDateString("en-IN", {
    timeZone: brand.timezone,
    day: "numeric",
    month: "short",
  });
  return `${dayPart}, ${clock(iso)}`;
}
---

<AppLayout title={`${label} — ${brand.name}`}>
  <StationShell
    role={profile!.role}
    grants={grants}
    name={profile!.name}
    pathname={Astro.url.pathname}
    counts={{ "/staff/today": day.openTabs.length }}
  >
    <StationMasthead title={label}>
      <PeriodPicker slot="actions" sel={sel} activity={activity} basePath="/staff/today" />
    </StationMasthead>

    {/* The shift in one line. Takings lead because it is the number a manager
        opens this page for; everything else qualifies it. */}
    <section class="tally st-rise" aria-label="Day summary">
      <div class="tally__cell tally__cell--lead">
        <p class="tally__label">Takings</p>
        <p class="tally__value">{formatINR(day.totals.takings)}</p>
      </div>
      <div class="tally__cell">
        <p class="tally__label">Orders</p>
        <p class="tally__value">
          {day.totals.orderCount}
          {day.totals.cancelledCount > 0 && (
            <span class="tally__sub">{day.totals.cancelledCount} cancelled</span>
          )}
        </p>
      </div>
      <div class="tally__cell">
        <p class="tally__label">Open tabs</p>
        <p class="tally__value">
          {day.openTabs.length}
          {day.totals.openValue > 0 && (
            <span class="tally__sub">{formatINR(day.totals.openValue)} unbilled</span>
          )}
        </p>
      </div>
      <div class="tally__cell">
        <p class="tally__label">Closed</p>
        <p class="tally__value">
          {day.closedTabs.length}
          {day.totals.closedValue > 0 && (
            <span class="tally__sub">{formatINR(day.totals.closedValue)}</span>
          )}
        </p>
      </div>
    </section>

    <section class="st-rise-2" aria-labelledby="tabs-h">
      <h2 class="sec__title" id="tabs-h">Tabs</h2>
      {day.openTabs.length === 0 && day.closedTabs.length === 0 ? (
        <p class="st-empty">No tabs opened in this {isRange ? "range" : "day"}.</p>
      ) : (
        <ul class="rows">
          {day.openTabs.map((t) => (
            <li class="row">
              <a class="row__main" href={`/staff/tabs/${t.id}`}>
                <span class="row__title">Table {t.table_label}</span>
                <span class="row__meta">
                  {t.carried
                    ? `Open since ${stamp(t.opened_at)}`
                    : `Opened ${clock(t.opened_at)}`} · {t.order_count}{" "}
                  {t.order_count === 1 ? "round" : "rounds"}
                  {t.assigned && <> · {assigneeName(t.assigned)}</>}
                </span>
              </a>
              <span class="row__amount">{formatINR(t.subtotal)}</span>
              <span class="pill pill--accent tag">Open</span>
            </li>
          ))}
          {day.closedTabs.map((t) => (
            <li class="row">
              <a class="row__main" href={`/staff/tabs/${t.id}`}>
                <span class="row__title">Table {t.table_label}</span>
                <span class="row__meta">
                  {clock(t.opened_at)}–{t.closed_at ? clock(t.closed_at) : "—"} ·{" "}
                  {t.order_count} {t.order_count === 1 ? "round" : "rounds"}
                  {t.assigned && <> · {assigneeName(t.assigned)}</>}
                </span>
              </a>
              <span class="row__amount">{formatINR(t.subtotal)}</span>
              <span class="pill tag">Closed</span>
            </li>
          ))}
        </ul>
      )}
    </section>

    {/* A range gets its days, not its individual rounds: thirty days of
        rounds is a wall, thirty daily figures is a report you can read. Each
        day links through to itself. */}
    {isRange && (
      <section class="st-rise-2" aria-labelledby="days-h">
        <h2 class="sec__title" id="days-h">By day</h2>
        {breakdown.length === 0 ? (
          <p class="st-empty">Nothing was taken in this range.</p>
        ) : (
          <ul class="rows">
            {breakdown.map((d) => (
              <li class="row">
                <a class="row__main" href={`/staff/today?date=${d.key}`}>
                  <span class="row__title">{dayLabel(d.key)}</span>
                  <span class="row__meta">
                    {d.orders} {d.orders === 1 ? "order" : "orders"}
                    {bestDay && d.key === bestDay.key && breakdown.length > 1 && (
                      <span class="row__best"> · best day</span>
                    )}
                  </span>
                </a>
                <span class="row__amount">{formatINR(d.takings)}</span>
              </li>
            ))}
          </ul>
        )}
        <p class="st-note">
          {span} {span === 1 ? "day" : "days"} ·{" "}
          {breakdown.length} {breakdown.length === 1 ? "day traded" : "days traded"} ·{" "}
          average {formatINR(Math.round(day.totals.takings / Math.max(1, breakdown.length)))} on a
          day that traded
        </p>
      </section>
    )}

    <section class="st-rise-2" aria-labelledby="orders-h">
      <h2 class="sec__title" id="orders-h">Orders</h2>
      {day.orders.length === 0 ? (
        <p class="st-empty">{isRange ? "No orders in this range." : "No orders on this day."}</p>
      ) : (
        <ul class="rows">
          {day.orders.map((o) => (
            <li class={`row ${o.status === "cancelled" ? "row--void" : ""}`}>
              <a class="row__main" href={`/staff?code=${o.code}`}>
                <span class="row__title">{o.code}</span>
                <span class="row__meta">
                  {isRange ? stamp(o.created_at) : clock(o.created_at)} ·{" "}
                  {o.table_label ? `Table ${o.table_label}` : "No table"} ·{" "}
                  {o.source === "customer" ? "Guest" : "Server"}
                  {/* A void is the one action that makes money disappear, so
                      the day view says who did it. */}
                  {o.status === "cancelled" && (
                    <span class="row__void">
                      {o.cancelled_by
                        ? ` · voided by ${assigneeName(o.cancelled_by)}`
                        : " · voided (author not recorded)"}
                    </span>
                  )}
                </span>
              </a>
              <span class="row__amount">{formatINR(o.subtotal)}</span>
              <span class={`pill pill--${o.status} tag`}>{o.status}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  </StationShell>
</AppLayout>

<style>
  .row__best {
    color: var(--accent);
    font-weight: 600;
  }
  .st-note {
    margin-block-start: var(--space-12);
    font-size: var(--fs-caption);
    color: var(--ink-muted);
  }



  /* Summary strip. Takings gets the display face and twice the size — it is the
     one figure worth reading from across a desk. */
  .tally {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-16);
    padding: var(--space-24);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .tally__label {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .tally__value {
    margin-block-start: var(--space-4);
    font-size: var(--fs-heading-s);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .tally__cell--lead .tally__value {
    font-family: var(--font-display);
    font-size: var(--fs-heading-l);
    font-weight: 400;
    line-height: var(--lh-heading);
  }
  .tally__sub {
    display: block;
    margin-block-start: 2px;
    font-family: var(--font-ui);
    font-size: var(--fs-caption);
    font-weight: 500;
    color: var(--ink-muted);
  }

  .sec__title {
    margin-block-end: var(--space-12);
    color: var(--ink);
  }

  .rows {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    min-height: 3.5rem;
    padding: var(--space-8) var(--space-16);
    background: var(--surface-raised);
    border-bottom: 1px solid var(--border);
  }
  .row:last-child {
    border-bottom: 0;
  }
  .row__main {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .row__title {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--ink);
  }
  .row__meta {
    font-size: var(--fs-caption);
    color: var(--ink-muted);
  }
  .row__amount {
    flex: 0 0 auto;
    font-size: var(--fs-body);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .row__void {
    color: var(--danger);
    font-weight: 600;
  }
  .row--void .row__title,
  .row--void .row__amount {
    color: var(--ink-muted);
    text-decoration: line-through;
  }

  /* The status column lines up down the list, so the pills share a width. */
  .tag {
    min-width: 5.5rem;
  }

  @media (max-width: 48rem) {
    .row {
      flex-wrap: wrap;
    }
    .row__main {
      flex-basis: 100%;
    }
  }
</style>
