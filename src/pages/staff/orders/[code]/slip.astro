---
/**
 * Order slip (Feature: printing). A print-optimised ticket for one round —
 * code, table, items + notes — that staff can send to a receipt/kitchen
 * printer. Behind the auth middleware (any staff). On screen it's a narrow card
 * on the app surface; @media print switches to ink-on-white receipt stock and
 * hides the buttons.
 */
import AppLayout from "../../../../layouts/AppLayout.astro";
import { getStaffOrder } from "../../../../lib/orders/staff";
import { brand } from "../../../../data/brand";

export const prerender = false;

const { supabase, profile } = Astro.locals;
const code = (Astro.params.code ?? "").toUpperCase();
const order = await getStaffOrder(supabase, code);

if (!order) Astro.response.status = 404;

// Back to wherever this role works — kitchen prints slips too.
const backHref =
  profile!.role === "kitchen" ? "/kitchen" : `/staff?code=${order?.code ?? ""}`;

// Printed at the foot so a cook can tell whether the auto-cutter clipped a line.
const lineCount = order?.items.length ?? 0;
const unitCount = order?.items.reduce((n, l) => n + l.qty, 0) ?? 0;

function when(iso: string): string {
  try {
    return new Date(iso).toLocaleString("en-IN", {
      hour: "2-digit",
      minute: "2-digit",
      day: "numeric",
      month: "short",
    });
  } catch {
    return "";
  }
}
---

<AppLayout title={order ? `Slip ${order.code} — ${brand.name}` : `Order not found — ${brand.name}`}>
  <main class="slipwrap">
    {!order ? (
      <p class="slipwrap__missing">No order found for <strong>{code}</strong>.</p>
    ) : (
      <>
        <div class="actions no-print">
          <a class="actions__back" href={backHref}>← Back</a>
          <button id="print-btn" type="button" class="actions__print">Print slip</button>
        </div>

        <article class="kot">
          {/* The table routes the food, so it is the one loud thing on the
              ticket. Knocked out of a solid band: thermal paper has no colour,
              but it inverts cleanly, and that is the only emphasis that
              survives steam and a glance from across the pass. */}
          <p class="kot__brand">{brand.name}</p>

          <header class="kot__table">
            <span class="kot__table-word">Table</span>
            <span class="kot__table-num">{order.table_label ?? "—"}</span>
          </header>

          <div class="kot__meta">
            <span>{order.code}</span>
            <span>{when(order.created_at)}</span>
          </div>

          {/* Above the items, not below: a note that changes how the whole
              order is cooked is worthless discovered after the last line. */}
          {order.notes && <p class="kot__ordernote">{order.notes}</p>}

          <ul class="kot__items">
            {order.items.map((line) => (
              <li class="kot__item">
                <span class="kot__qty">{line.qty}</span>
                <span class="kot__lines">
                  <span class="kot__name">{line.name}</span>
                  {line.notes && <span class="kot__note">{line.notes}</span>}
                </span>
              </li>
            ))}
          </ul>

          {/* A checksum for the cutter: if the roll clipped a line, the counts
              won't match what's on the paper. */}
          <p class="kot__foot">
            {lineCount} {lineCount === 1 ? "line" : "lines"} · {unitCount}{" "}
            {unitCount === 1 ? "item" : "items"}
          </p>
        </article>
      </>
    )}
  </main>
</AppLayout>

<script>
  document.getElementById("print-btn")?.addEventListener("click", () => window.print());
</script>

<style>
  .slipwrap {
    max-width: 22rem;
    margin-inline: auto;
    padding: var(--space-24) var(--gutter) var(--space-64);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }
  .slipwrap__missing {
    padding-block: var(--space-64);
    text-align: center;
    color: var(--ink-muted);
  }
  .actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
  }
  .actions__back {
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .actions__print {
    min-height: 2.5rem;
    padding-inline: var(--space-24);
    background: var(--accent);
    color: var(--on-accent);
    border: none;
    border-radius: var(--radius-md);
    font: inherit;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    cursor: pointer;
  }

  /* The ticket. Sized in mm because the target is a 72mm printable strip, not a
     viewport; on screen it renders at the same proportions so what staff check
     is what the roll produces. DM Sans throughout — the display serif is the
     customer's voice and has no business on a line cook's ticket. */
  /* On screen this is a PREVIEW of a physical slip, so it is shaped like one:
     80mm-proportioned, white paper, lifted off the app surface. Presented as a
     UI card instead, the inverted header reads as a stray black slab; presented
     as paper, it reads as a receipt — and what staff check matches what the
     roll actually produces. */
  .kot {
    width: 100%;
    max-width: 20rem;
    background: #fff;
    color: #17150f;
    font-family: var(--font-ui);
    border-radius: 2px;
    overflow: hidden;
    box-shadow:
      0 1px 2px rgb(23 21 18 / 0.08),
      0 8px 24px -12px rgb(23 21 18 / 0.3);
  }

  .kot__brand {
    padding: var(--space-16) var(--space-16) 0;
    text-align: center;
    font-size: var(--fs-caption);
    font-weight: 500;
    color: #6b6459;
  }

  /* Label above value: "Table" and "Patio" on one baseline forces a tiny word
     against a huge one and the pairing looks accidental. Stacked, the value
     can be as large as it likes without dragging the label around. */
  .kot__table {
    margin: var(--space-12) var(--space-16) 0;
    padding: var(--space-8) var(--space-12) var(--space-12);
    background: #17150f;
    color: #fff;
    border-radius: 2px;
  }
  .kot__table-word {
    display: block;
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    opacity: 0.75;
  }
  .kot__table-num {
    display: block;
    margin-block-start: 2px;
    /* Scales down for a long label ("Patio") and stays huge for "7". */
    font-size: clamp(1.75rem, 1.1rem + 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .kot__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-12);
    padding: var(--space-8) var(--space-16);
    font-size: var(--fs-caption);
    font-variant-numeric: tabular-nums;
    color: #6b6459;
  }

  .kot__ordernote {
    margin: 0 var(--space-16);
    padding: var(--space-8) var(--space-12);
    background: #17150f;
    color: #fff;
    border-radius: 2px;
    font-size: var(--fs-caption);
    font-weight: 600;
  }

  .kot__items {
    margin-block-start: var(--space-12);
    padding-inline: var(--space-16);
    border-top: 1px dashed #b9b2a5;
  }
  /* Dashed, not hairline: a 1px grey rule dithers on thermal paper and can
     disappear entirely. A dash pattern always prints. */
  .kot__item {
    display: flex;
    gap: var(--space-12);
    padding-block: var(--space-12);
    border-bottom: 1px dashed #b9b2a5;
  }
  .kot__item:last-child {
    border-bottom: 0;
  }
  /* Fixed column so 2 and 12 stack in line and the eye can run down the
     quantities without reading the names. No "×" — the column position already
     says quantity, and the glyph is noise at this size. */
  .kot__qty {
    flex: 0 0 2.25rem;
    text-align: right;
    font-size: var(--fs-heading-s);
    font-weight: 700;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }
  .kot__lines {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }
  .kot__name {
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.25;
  }
  /* Inverted, because a missed modifier means the dish gets remade. This is the
     one thing on the ticket that must survive a distracted glance. */
  .kot__note {
    align-self: flex-start;
    padding: 2px var(--space-8);
    background: #17150f;
    color: #fff;
    border-radius: 2px;
    font-size: var(--fs-caption);
    font-weight: 600;
  }

  .kot__foot {
    padding: var(--space-12) var(--space-16) var(--space-24);
    text-align: center;
    font-size: var(--fs-caption);
    font-variant-numeric: tabular-nums;
    color: #6b6459;
  }

  @media print {
    /* Kitchen tickets go to an 80mm thermal roll, not A4. `auto` height lets
       the roll run as long as the order needs and cut. Matches the customer
       bill in staff/tabs/[id].astro so both slips come off the same hardware
       identically. */
    @page {
      size: 80mm auto;
      margin: 3mm;
    }
    :global(body) {
      background: #fff !important;
    }
    .slipwrap {
      max-width: none;
      padding: 0;
    }
    .no-print {
      display: none !important;
    }
    /* Thermal paper is 1-bit. Every grey becomes a dither pattern that muddies
       under kitchen heat, so the whole ticket collapses to pure black on white
       and the inverted blocks must print as solid ink, not be "optimised" away
       by the browser's background-graphics default. */
    .kot {
      max-width: none;
      border-radius: 0;
      box-shadow: none;
      background: #fff;
      color: #000;
    }
    /* The paper is the page, so the preview's inset margins go away. */
    .kot__brand,
    .kot__meta,
    .kot__items,
    .kot__foot {
      padding-inline: 0;
    }
    .kot__table,
    .kot__ordernote {
      margin-inline: 0;
      border-radius: 0;
    }
    /* Thermal paper is 1-bit: every grey becomes a dither pattern that muddies
       under kitchen heat. Collapse to pure ink, and force the inverted blocks
       to print solid rather than be dropped as "background graphics". */
    .kot__table,
    .kot__note,
    .kot__ordernote {
      background: #000 !important;
      color: #fff !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .kot__brand,
    .kot__meta,
    .kot__foot {
      color: #000;
    }
    .kot__items,
    .kot__item {
      border-color: #000;
    }
    .kot__table {
      padding: 2mm 3mm 3mm;
    }
    .kot__table-num {
      font-size: 13mm;
    }
    /* Bigger than screen: read at arm's length, often through steam. */
    .kot__qty {
      flex-basis: 9mm;
      font-size: 6mm;
    }
    .kot__name {
      font-size: 4.6mm;
    }
    .kot__note {
      font-size: 3.6mm;
    }
    /* Feed past the tear bar so the cutter doesn't take the last line. */
    .kot__foot {
      padding-block-end: 12mm;
    }
  }
</style>
