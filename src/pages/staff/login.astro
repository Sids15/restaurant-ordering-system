---
/**
 * Staff login. Public within the protected /staff area. Posts credentials to
 * /api/auth/login, which signs in and sets the session cookies. Already-signed-in
 * staff are sent through — unless their role can't open the target, in which case
 * the form is shown so they can sign in with the right account.
 *
 * Design: a split "back-of-house door" — the nocturnal rooftop panel beside a
 * quiet sign-in column, in the marketing site's night vocabulary.
 */
import { Picture } from "astro:assets";
import AppLayout from "../../layouts/AppLayout.astro";
import { safeNext } from "../../lib/http/safe-next";
import { roleCanAccess } from "../../lib/auth/access";
import rooftop from "../../assets/rooftop/rooftop-city-night.jpg";

export const prerender = false;

const params = Astro.url.searchParams;
const next = safeNext(params.get("next"));
const error = params.get("error");

let signedInRole: string | null = null;
const {
  data: { user },
} = await Astro.locals.supabase.auth.getUser();
if (user) {
  const { data: prof } = await Astro.locals.supabase
    .from("profiles")
    .select("role")
    .eq("id", user.id)
    .maybeSingle();
  signedInRole = prof?.role ?? null;
  if (roleCanAccess(next, signedInRole as never)) {
    return Astro.redirect(next, 302);
  }
}

const ERROR_COPY: Record<string, string> = {
  invalid: "That email and password don't match. Please try again.",
  missing: "Enter your email and password.",
  throttled: "Too many sign-in attempts. Please wait a few minutes and try again.",
};
const errorText = error ? (ERROR_COPY[error] ?? "Couldn't sign you in.") : null;
---

<AppLayout title="Sign in — Berlin">
  <main class="login">
    <!-- Brand panel -->
    <aside class="login__aside">
      <Picture
        src={rooftop}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        alt="Berlin — Haus de Gourmet, a rooftop above the city at night"
        widths={[600, 900, 1400]}
        sizes="(max-width: 60rem) 100vw, 55vw"
        class="login__aside-img"
      />
      <div class="login__aside-scrim" aria-hidden="true"></div>
      <div class="login__aside-inner">
        <p class="login__aside-top">Staff &amp; kitchen entrance</p>
        <div class="login__aside-brand">
          <p class="login__aside-eyebrow">Haus de Gourmet</p>
          <p class="login__wordmark">Berlin</p>
          <p class="login__aside-tag">A rooftop gourmet house, above the city.</p>
        </div>
      </div>
    </aside>

    <!-- Sign-in column -->
    <section class="login__main">
      <div class="login__stage">
        <header class="login__head">
          <p class="login__eyebrow">Back of house</p>
          <h1 class="login__title">Sign in</h1>
          <p class="login__sub">Welcome back. Sign in to continue.</p>
        </header>

        {errorText && <p class="login__alert login__alert--error" role="alert">{errorText}</p>}
        {signedInRole && !errorText && (
          <p class="login__alert" role="status">
            You're signed in as <strong>{signedInRole}</strong>. Sign in with the
            account for this area to continue.
          </p>
        )}

        <form class="login__form" method="post" action="/api/auth/login">
          <input type="hidden" name="next" value={next} />

          <label class="field">
            <span class="field__label">Email</span>
            <input class="field__input" type="email" name="email" autocomplete="username" required autofocus />
          </label>

          <label class="field">
            <span class="field__label">Password</span>
            <input
              class="field__input"
              type="password"
              name="password"
              autocomplete="current-password"
              required
              data-password
            />
            <button type="button" class="field__reveal" data-reveal aria-pressed="false">Show</button>
          </label>

          <button class="login__submit" type="submit" data-submit>
            <span class="login__submit-label">Sign in</span>
            <svg class="login__submit-arrow" width="34" height="8" viewBox="0 0 34 8" fill="none" aria-hidden="true">
              <path d="M0 4h32M32 4l-5-3.25M32 4l-5 3.25" stroke="currentColor" stroke-width="1" stroke-linecap="square" />
            </svg>
          </button>

          <p class="login__help">Trouble signing in? Ask your manager to reset your access.</p>
        </form>

        <p class="login__foot">Berlin · Haus de Gourmet</p>
      </div>
    </section>
  </main>
</AppLayout>

<script>
  const reveal = document.querySelector<HTMLButtonElement>("[data-reveal]");
  const pw = document.querySelector<HTMLInputElement>("[data-password]");
  reveal?.addEventListener("click", () => {
    const show = pw?.type === "password";
    if (pw) pw.type = show ? "text" : "password";
    reveal.textContent = show ? "Hide" : "Show";
    reveal.setAttribute("aria-pressed", String(show));
  });

  const form = document.querySelector<HTMLFormElement>(".login__form");
  const submit = document.querySelector<HTMLButtonElement>("[data-submit]");
  const label = submit?.querySelector<HTMLElement>(".login__submit-label");
  form?.addEventListener("submit", () => {
    if (form.checkValidity() && submit && label) {
      submit.disabled = true;
      label.textContent = "Signing in…";
    }
  });
</script>

<style>
  .login {
    min-height: 100svh;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    background: var(--color-void);
  }

  /* --- Brand panel -------------------------------------------------------- */
  .login__aside {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .login__aside-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.7) contrast(1.05) saturate(0.95);
  }
  .login__aside-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to top, var(--color-void) 4%, rgba(9, 9, 8, 0.15) 55%, rgba(9, 9, 8, 0.55) 100%),
      linear-gradient(to right, rgba(9, 9, 8, 0.55), rgba(9, 9, 8, 0) 60%);
  }
  .login__aside-inner {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(2rem, 4vw, 3.5rem);
  }
  .login__aside-top {
    font-family: var(--font-ui);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .login__aside-eyebrow {
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .login__wordmark {
    margin-block-start: var(--space-8);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3.5rem, 7vw, 6rem);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--text-strong);
  }
  .login__aside-tag {
    margin-block-start: var(--space-16);
    max-width: 20rem;
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1.7;
    color: var(--text-muted);
  }

  /* --- Sign-in column ----------------------------------------------------- */
  .login__main {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--gutter);
    border-inline-start: 1px solid var(--accent-muted);
  }
  .login__main::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(70% 50% at 50% 0%, rgba(180, 154, 99, 0.08), transparent 70%);
  }
  .login__stage {
    position: relative;
    width: 100%;
    max-width: 22rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }
  .login__head {
    display: flex;
    flex-direction: column;
  }
  .login__eyebrow {
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .login__eyebrow::after {
    content: "";
    display: block;
    width: 2.75rem;
    height: 1px;
    margin-block-start: var(--space-16);
    background: var(--accent-muted);
  }
  .login__title {
    margin-block-start: var(--space-24);
    font-family: var(--font-display);
    font-size: var(--fs-display-s);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
  }
  .login__sub {
    margin-block-start: var(--space-12);
    font-size: var(--fs-body);
    color: var(--text-muted);
  }

  .login__alert {
    padding: var(--space-12) var(--space-16);
    font-size: var(--fs-caption);
    line-height: 1.5;
    color: var(--text);
    border-inline-start: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
  }
  .login__alert strong {
    color: var(--text-strong);
    text-transform: capitalize;
  }
  .login__alert--error {
    border-inline-start-color: var(--color-berlin-red);
    background: color-mix(in srgb, var(--color-berlin-red) 14%, transparent);
  }

  .login__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }
  .field {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .field__label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color 0.3s var(--ease-out);
  }
  .field:focus-within .field__label {
    color: var(--accent);
  }
  .field__input {
    width: 100%;
    padding: var(--space-12) 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border-strong);
    color: var(--text-strong);
    font: inherit;
    font-size: var(--fs-body-l);
    border-radius: 0;
  }
  .field__input:focus {
    outline: none;
  }
  .field::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }
  .field:focus-within::after {
    transform: scaleX(1);
  }
  .field__input:-webkit-autofill,
  .field__input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--text-strong);
    -webkit-box-shadow: 0 0 0 1000px var(--color-void) inset;
    caret-color: var(--text-strong);
    transition: background-color 9999s ease-out 0s;
  }
  .field__reveal {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.3s var(--ease-out);
  }
  .field__reveal:hover,
  .field__reveal:focus-visible {
    color: var(--accent);
    outline: none;
  }

  .login__submit {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    min-height: var(--btn-height);
    padding-inline: var(--space-24);
    margin-block-start: var(--space-8);
    background: var(--accent);
    color: var(--color-warm-black);
    border: none;
    font: inherit;
    font-weight: 600;
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.35s var(--ease-out), transform 0.2s var(--ease-out);
  }
  .login__submit:hover {
    background: var(--color-white);
  }
  .login__submit:active {
    transform: translateY(1px);
  }
  .login__submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }
  .login__submit-arrow {
    transition: transform 0.35s var(--ease-out);
  }
  .login__submit:hover .login__submit-arrow {
    transform: translateX(4px);
  }

  .login__help {
    margin-block-start: calc(-1 * var(--space-16));
    font-size: var(--fs-caption);
    line-height: 1.5;
    color: var(--text-muted);
  }
  .login__foot {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* --- Responsive --------------------------------------------------------- */
  @media (max-width: 60rem) {
    .login {
      grid-template-columns: 1fr;
      grid-template-rows: 38svh 1fr;
    }
    .login__main {
      border-inline-start: none;
      border-block-start: 1px solid var(--accent-muted);
    }
  }
  @media (max-width: 60rem) and (max-height: 40rem) {
    .login {
      grid-template-rows: none;
      grid-template-columns: 1fr;
    }
    .login__aside {
      display: none;
    }
  }

  /* --- Motion ------------------------------------------------------------- */
  @media (prefers-reduced-motion: no-preference) {
    .login__aside-inner > *,
    .login__head,
    .login__form,
    .login__foot {
      animation: login-rise var(--dur-entry) var(--ease-out) both;
    }
    .login__aside-brand {
      animation-delay: 120ms;
    }
    .login__form {
      animation-delay: 180ms;
    }
    .login__foot {
      animation-delay: 300ms;
    }
    @keyframes login-rise {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
