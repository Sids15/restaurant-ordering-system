---
/**
 * Staff login. Public within the protected /staff area. Posts credentials to
 * /api/auth/login, which signs in and sets the session cookies. Already-signed-in
 * staff are sent through — unless their role can't open the target, in which case
 * the form is shown so they can sign in with the right account.
 *
 * Design: a split "back-of-house door" — a warm branded panel (built from the
 * design tokens, no photo) beside a quiet sign-in column.
 */
import AppLayout from "../../layouts/AppLayout.astro";
import { safeNext } from "../../lib/http/safe-next";
import { pathAllowed } from "../../lib/auth/access";
import { loadStaff } from "../../lib/auth/session";
import { brand } from "../../data/brand";

export const prerender = false;

const params = Astro.url.searchParams;
const next = safeNext(params.get("next"));
const error = params.get("error");

// Someone already signed in who can open the destination is sent straight
// through; someone signed in who CAN'T sees the form, so they can switch to an
// account that has the permission rather than bouncing in a redirect loop.
const { user, profile, grants } = await loadStaff(Astro.locals.supabase);
const signedInRole: string | null = profile?.role ?? null;
if (user && profile && pathAllowed(next, grants)) {
  return Astro.redirect(next, 302);
}

const ERROR_COPY: Record<string, string> = {
  invalid: "That email and password don't match. Please try again.",
  // These two are project settings, not user error. Saying so saves whoever
  // hits it from testing passwords that were never the problem.
  captcha:
    "Supabase is refusing sign-ins because CAPTCHA protection is on, and this app doesn't send a CAPTCHA. Turn it off under Authentication → Attack Protection.",
  unconfirmed:
    "That account hasn't been confirmed yet. Confirm it in Supabase → Authentication → Users, or tick Auto Confirm when creating it.",
  missing: "Enter your email and password.",
  throttled: "Too many sign-in attempts. Please wait a few minutes and try again.",
};
const errorText = error ? (ERROR_COPY[error] ?? "Couldn't sign you in.") : null;
---

<AppLayout title={`Sign in — ${brand.name}`}>
  <main class="login">
    <!-- Brand panel -->
    <aside class="login__aside">
      <div class="login__aside-inner">
        <p class="login__aside-top">Staff &amp; kitchen entrance</p>
        <div class="login__aside-brand">
          <p class="login__aside-eyebrow">{brand.tagline}</p>
          <p class="login__wordmark">{brand.name}</p>
        </div>
      </div>
    </aside>

    <!-- Sign-in column -->
    <section class="login__main">
      <div class="login__stage">
        <header class="login__head">
          <p class="login__eyebrow">Back of house</p>
          <h1 class="login__title">Sign in</h1>
          <p class="login__sub">Welcome back. Sign in to continue.</p>
        </header>

        {errorText && <p class="login__alert login__alert--error" role="alert">{errorText}</p>}
        {signedInRole && !errorText && (
          <p class="login__alert" role="status">
            You're signed in as <strong>{signedInRole}</strong>. Sign in with the
            account for this area to continue.
          </p>
        )}

        <form class="login__form" method="post" action="/api/auth/login">
          <input type="hidden" name="next" value={next} />

          <label class="field">
            <span class="field__label">Email</span>
            <input class="field__input" type="email" name="email" autocomplete="username" required autofocus />
          </label>

          <label class="field">
            <span class="field__label">Password</span>
            <input
              class="field__input"
              type="password"
              name="password"
              autocomplete="current-password"
              required
              data-password
            />
            <button type="button" class="field__reveal" data-reveal aria-pressed="false">Show</button>
          </label>

          <button class="login__submit" type="submit" data-submit>
            <span class="login__submit-label">Sign in</span>
            <svg class="login__submit-arrow" width="34" height="8" viewBox="0 0 34 8" fill="none" aria-hidden="true">
              <path d="M0 4h32M32 4l-5-3.25M32 4l-5 3.25" stroke="currentColor" stroke-width="1" stroke-linecap="square" />
            </svg>
          </button>

          <p class="login__help">Trouble signing in? Ask your manager to reset your access.</p>
        </form>

        <p class="login__foot">{brand.name}</p>
      </div>
    </section>
  </main>
</AppLayout>

<script>
  const reveal = document.querySelector<HTMLButtonElement>("[data-reveal]");
  const pw = document.querySelector<HTMLInputElement>("[data-password]");
  reveal?.addEventListener("click", () => {
    const show = pw?.type === "password";
    if (pw) pw.type = show ? "text" : "password";
    reveal.textContent = show ? "Hide" : "Show";
    reveal.setAttribute("aria-pressed", String(show));
  });

  const form = document.querySelector<HTMLFormElement>(".login__form");
  const submit = document.querySelector<HTMLButtonElement>("[data-submit]");
  const label = submit?.querySelector<HTMLElement>(".login__submit-label");
  form?.addEventListener("submit", () => {
    if (form.checkValidity() && submit && label) {
      submit.disabled = true;
      label.textContent = "Signing in…";
    }
  });
</script>

<style>
  .login {
    min-height: 100svh;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    background: var(--surface);
  }

  /* --- Brand panel -------------------------------------------------------- */
  .login__aside {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(120% 90% at 15% 10%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 60%),
      linear-gradient(160deg, var(--accent-soft), var(--surface-sunken) 70%);
  }
  .login__aside-inner {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(2rem, 4vw, 3.5rem);
  }
  .login__aside-top {
    font-family: var(--font-ui);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .login__aside-eyebrow {
    font-family: var(--font-ui);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .login__wordmark {
    margin-block-start: var(--space-8);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-display-xl);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-display);
    color: var(--ink);
  }

  /* --- Sign-in column ----------------------------------------------------- */
  .login__main {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--gutter);
    border-inline-start: 1px solid var(--border);
    background: var(--surface);
  }
  .login__stage {
    position: relative;
    width: 100%;
    max-width: 22rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }
  .login__head {
    display: flex;
    flex-direction: column;
  }
  .login__eyebrow {
    font-family: var(--font-ui);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .login__eyebrow::after {
    content: "";
    display: block;
    width: 2.75rem;
    height: 1px;
    margin-block-start: var(--space-16);
    background: var(--border-strong);
  }
  .login__title {
    margin-block-start: var(--space-24);
    color: var(--ink);
  }
  .login__sub {
    margin-block-start: var(--space-12);
    font-size: var(--fs-body);
    color: var(--ink-muted);
  }

  .login__alert {
    padding: var(--space-12) var(--space-16);
    font-size: var(--fs-caption);
    line-height: var(--lh-body);
    color: var(--ink);
    border-inline-start: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius-md);
  }
  .login__alert strong {
    color: var(--ink);
    text-transform: capitalize;
  }
  .login__alert--error {
    border-inline-start-color: var(--danger);
    background: var(--danger-soft);
  }

  .login__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }
  .field {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .field__label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .field:focus-within .field__label {
    color: var(--accent);
  }
  .field__input {
    width: 100%;
    padding: var(--space-12) 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border-strong);
    color: var(--ink);
    font: inherit;
    font-size: var(--fs-body-l);
    border-radius: 0;
  }
  .field__input:focus {
    outline: none;
  }
  .field::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-reveal) var(--ease-out);
  }
  .field:focus-within::after {
    transform: scaleX(1);
  }
  .field__input:-webkit-autofill,
  .field__input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--ink);
    -webkit-box-shadow: 0 0 0 1000px var(--surface) inset;
    caret-color: var(--ink);
    transition: background-color 9999s ease-out 0s;
  }
  .field__reveal {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .field__reveal:hover,
  .field__reveal:focus-visible {
    color: var(--accent);
    outline: none;
  }

  .login__submit {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    min-height: var(--btn-height);
    padding-inline: var(--btn-padding-inline);
    margin-block-start: var(--space-8);
    background: var(--accent);
    color: var(--on-accent);
    border: none;
    border-radius: var(--radius-md);
    font: inherit;
    font-weight: 600;
    font-size: var(--fs-body);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .login__submit:hover {
    background: var(--accent-hover);
  }
  .login__submit:active {
    transform: translateY(1px);
  }
  .login__submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }
  .login__submit-arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .login__submit:hover .login__submit-arrow {
    transform: translateX(4px);
  }

  .login__help {
    margin-block-start: calc(-1 * var(--space-16));
    font-size: var(--fs-caption);
    line-height: var(--lh-body);
    color: var(--ink-muted);
  }
  .login__foot {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* --- Responsive --------------------------------------------------------- */
  @media (max-width: 60rem) {
    .login {
      grid-template-columns: 1fr;
      grid-template-rows: 32svh 1fr;
    }
    .login__main {
      border-inline-start: none;
      border-block-start: 1px solid var(--border);
    }
  }
  @media (max-width: 60rem) and (max-height: 40rem) {
    .login {
      grid-template-rows: none;
      grid-template-columns: 1fr;
    }
    .login__aside {
      display: none;
    }
  }

  /* --- Motion ------------------------------------------------------------- */
  @media (prefers-reduced-motion: no-preference) {
    .login__aside-inner > *,
    .login__head,
    .login__form,
    .login__foot {
      /* backwards, not both — see the note on st-rise in staff.css. */
      animation: login-rise var(--dur-reveal) var(--ease-out) backwards;
    }
    .login__aside-brand {
      animation-delay: 90ms;
    }
    .login__form {
      animation-delay: 140ms;
    }
    .login__foot {
      animation-delay: 220ms;
    }
    @keyframes login-rise {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        /* none, not translateY(0) — see the note on st-rise in staff.css. */
        transform: none;
      }
    }
  }
</style>
