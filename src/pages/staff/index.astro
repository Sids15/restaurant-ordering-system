---
/**
 * Staff console (Feature 4). A server looks up an order by its code, reviews it,
 * and confirms it — the confirm is what flips the customer's tracking page from
 * "Waiting" to "Order placed". Behind the auth middleware, so `locals.profile`
 * is guaranteed here. Reads through the authenticated client (RLS applies).
 */
import AppLayout from "../../layouts/AppLayout.astro";
import StationMasthead from "../../components/staff/StationMasthead.astro";
import StationShell from "../../components/staff/StationShell.astro";
import PendingQueue from "../../components/order/PendingQueue.tsx";
import { getStaffOrder, getPendingOrders } from "../../lib/orders/staff";
import { formatINR } from "../../lib/money";
import { brand } from "../../data/brand";
import "../../styles/staff.css";

export const prerender = false;

const { supabase, profile } = Astro.locals;
const params = Astro.url.searchParams;

const rawCode = (params.get("code") ?? "").trim().toUpperCase();
const ok = params.get("ok"); // "confirmed" | "cancelled" | "created"
const err = params.get("err");

const order = rawCode ? await getStaffOrder(supabase, rawCode) : null;
const notFound = rawCode !== "" && !order;

const canTake = profile!.role === "manager" || profile!.role === "server";
// The pending queue (notification) is only meaningful to roles that confirm.
const pending = canTake ? await getPendingOrders(supabase) : [];
const STATUS_LABEL: Record<string, string> = {
  pending: "Waiting to be confirmed",
  confirmed: "Confirmed",
  preparing: "Preparing",
  ready: "Ready",
  served: "Served",
  cancelled: "Cancelled",
};

function when(iso: string): string {
  try {
    return new Date(iso).toLocaleString("en-IN", {
      hour: "2-digit",
      minute: "2-digit",
      day: "numeric",
      month: "short",
    });
  } catch {
    return "";
  }
}
---

<AppLayout title={`Staff console — ${brand.name}`}>
  <StationShell
    role={profile!.role}
    name={profile!.name}
    pathname={Astro.url.pathname}
    counts={{ "/staff": pending.length }}
  >
    <StationMasthead title="Order desk">
      {/* Stations and identity live in the sidebar now. What stays here is the
          desk's own primary action — the thing you came to this page to do. */}
      {canTake && (
        <a class="st-cta" slot="actions" href="/staff/new">
          <span aria-hidden="true">+</span> Build order
        </a>
      )}
    </StationMasthead>

    {canTake && <PendingQueue client:load initialOrders={pending} />}

    <form class={`lookup st-rise-2 ${!order ? "lookup--hero" : ""}`} method="get" action="/staff">
      <label class="lookup__label" for="code">Look up an order</label>
      <div class="lookup__row">
        <div class="lookup__field">
          <input
            class="lookup__input"
            id="code"
            name="code"
            value={rawCode}
            placeholder="3FTBUB"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            autofocus
          />
        </div>
        <button class="lookup__go st-btn st-btn--primary" type="submit">
          <span>Look up</span>
          <svg class="st-btn__arrow" width="30" height="8" viewBox="0 0 30 8" fill="none" aria-hidden="true">
            <path d="M0 4h28M28 4l-5-3.25M28 4l-5 3.25" stroke="currentColor" stroke-width="1" stroke-linecap="square" />
          </svg>
        </button>
      </div>
      <p class="lookup__hint">Read the six-character code from the guest's screen or QR.</p>
    </form>

    {ok && (
      <p class="st-alert st-alert--ok st-rise" role="status">
        {ok === "confirmed"
          ? `Order ${rawCode} confirmed — the table has been told.`
          : ok === "created"
            ? `Order ${rawCode} created and confirmed.`
            : `Order ${rawCode} cancelled.`}
      </p>
    )}
    {err && <p class="st-alert st-alert--error st-rise" role="alert">{err}</p>}

    {notFound && (
      <p class="st-empty">No order found for <strong>{rawCode}</strong>. Check the code and try again.</p>
    )}

    {order && (
      <section class="docket st-rise-2" aria-label={`Order ${order.code}`}>
        <header class="docket__head">
          <div class="docket__ident">
            <p class="docket__label">Docket</p>
            <p class="docket__code">{order.code}</p>
            <p class="docket__meta">
              {order.table_label ? `Table ${order.table_label}` : "No table"} ·
              {order.source === "customer" ? " Guest order" : " Server order"} ·
              {" "}{when(order.created_at)}
            </p>
          </div>
          <span class={`pill pill--${order.status}`}>{STATUS_LABEL[order.status]}</span>
        </header>

        <ul class="docket__lines">
          {order.items.map((line) => (
            <li class="docket__line">
              <span class="docket__qty">{line.qty}×</span>
              <span class="docket__name">
                {line.name}
                {line.notes && <span class="docket__lnote">{line.notes}</span>}
              </span>
              <span class="docket__price">{formatINR(line.price * line.qty)}</span>
            </li>
          ))}
        </ul>

        <div class="docket__total">
          <span>Subtotal</span>
          <span>{formatINR(order.subtotal)}</span>
        </div>

        {order.notes && <p class="docket__note">Note — {order.notes}</p>}

        <div class="docket__links">
          <a class="docket__link" href={`/staff/orders/${order.code}/slip`}>Print slip</a>
          {order.tab_id && <a class="docket__link" href={`/staff/tabs/${order.tab_id}`}>Bill · Table {order.table_label}</a>}
        </div>

        {canTake && order.status === "pending" && (
          <div class="actions">
            <form method="post" action={`/api/staff/orders/${order.code}`}>
              <input type="hidden" name="action" value="confirm" />
              <button class="st-btn st-btn--primary actions__confirm" type="submit">
                <span>Confirm order</span>
                <svg class="st-btn__arrow" width="30" height="8" viewBox="0 0 30 8" fill="none" aria-hidden="true">
                  <path d="M0 4h28M28 4l-5-3.25M28 4l-5 3.25" stroke="currentColor" stroke-width="1" stroke-linecap="square" />
                </svg>
              </button>
            </form>
            <form method="post" action={`/api/staff/orders/${order.code}`}>
              <input type="hidden" name="action" value="cancel" />
              <button class="st-btn st-btn--ghost" type="submit">Cancel</button>
            </form>
          </div>
        )}

        {canTake && order.status === "confirmed" && (
          <div class="actions">
            <p class="actions__done">Confirmed. The kitchen board will pick it up.</p>
            <form method="post" action={`/api/staff/orders/${order.code}`}>
              <input type="hidden" name="action" value="cancel" />
              <button class="st-btn st-btn--ghost" type="submit">Cancel</button>
            </form>
          </div>
        )}
      </section>
    )}
  </StationShell>
</AppLayout>

<style>
  /* --- Lookup ------------------------------------------------------------- */
  .lookup {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }
  .lookup--hero {
    align-items: center;
    text-align: center;
    padding-block: clamp(var(--space-16), 3vh, var(--space-32));
  }
  .lookup__label {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .lookup__row {
    display: flex;
    align-items: flex-end;
    gap: var(--space-16);
  }
  .lookup--hero .lookup__row {
    width: 100%;
    max-width: 32rem;
  }
  .lookup__field {
    flex: 1 1 auto;
  }
  .lookup__input {
    width: 100%;
    height: var(--btn-height);
    padding-inline: var(--space-16);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--ink);
    font: inherit;
    font-family: var(--font-display);
    font-size: var(--fs-heading-m);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .lookup__input::placeholder {
    color: var(--ink-muted);
    opacity: 0.6;
  }
  .lookup__input:focus-visible {
    border-color: var(--accent);
    outline: none;
  }
  .lookup__go {
    flex: 0 0 auto;
  }
  .lookup__hint {
    max-width: none;
    font-size: var(--fs-caption);
    color: var(--ink-muted);
  }

  /* --- The docket — order detail card -------------------------------------- */
  .docket {
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: clamp(var(--space-24), 4vw, var(--space-32));
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .docket__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-16);
    padding-block-end: var(--space-16);
    border-bottom: 1px solid var(--border);
  }
  .docket__label {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .docket__code {
    margin-block-start: var(--space-8);
    font-family: var(--font-display);
    font-size: var(--fs-heading-l);
    line-height: 1;
    letter-spacing: 0.06em;
    color: var(--ink);
  }
  .docket__meta {
    margin-block-start: var(--space-8);
    max-width: none;
    font-size: var(--fs-caption);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .docket__lines {
    display: flex;
    flex-direction: column;
  }
  .docket__line {
    display: flex;
    align-items: baseline;
    gap: var(--space-16);
    padding-block: var(--space-12);
    border-bottom: 1px solid var(--border);
  }
  .docket__line:first-child {
    padding-block-start: 0;
  }
  .docket__qty {
    flex: 0 0 auto;
    min-width: 2ch;
    color: var(--accent);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .docket__name {
    flex: 1 1 auto;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .docket__lnote {
    font-size: var(--fs-caption);
    color: var(--ink-muted);
  }
  .docket__price {
    flex: 0 0 auto;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .docket__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-16);
    padding-block-start: var(--space-4);
    font-size: var(--fs-body-l);
    color: var(--ink);
  }
  .docket__total span:first-child {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .docket__total span:last-child {
    font-family: var(--font-display);
    font-size: var(--fs-heading-m);
    font-variant-numeric: tabular-nums;
  }
  .docket__note {
    max-width: none;
    padding: var(--space-12) var(--space-16);
    font-size: var(--fs-caption);
    color: var(--ink);
    background: var(--accent-soft);
    border-radius: var(--radius-md);
    border-inline-start: 3px solid var(--accent);
  }
  .docket__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-24);
  }
  .docket__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--accent);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .docket__link:hover {
    color: var(--accent-hover);
  }

  /* --- Actions -------------------------------------------------------------- */
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding-block-start: var(--space-16);
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .actions__confirm {
    min-width: 15rem;
  }
  .actions__done {
    flex: 1 1 12rem;
    font-size: var(--fs-caption);
    color: var(--ink-muted);
  }

  @media (max-width: 36rem) {
    .lookup__row {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-16);
    }
    .lookup__go {
      width: 100%;
    }
    .actions {
      flex-direction: column;
      align-items: stretch;
    }
    .actions__confirm {
      min-width: 0;
    }
  }
</style>
