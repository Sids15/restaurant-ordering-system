---
/**
 * Collective bill (Feature: billing) for one tab — every non-cancelled round's
 * items merged, with GST + service charge. A server can Close the tab (mark
 * paid), Move it to another table, Merge another table's tab into it, and Print.
 * Behind the auth middleware; billing is manager/server. On screen the bill is a
 * Berlin-tailored thermal receipt on the dark app; @media print goes black-on-white.
 */
import AppLayout from "../../../layouts/AppLayout.astro";
import { getTabBill } from "../../../lib/orders/tabs";
import { formatINR } from "../../../lib/money";
import { SERVICE_RATE, GST_RATE } from "../../../lib/billing";
import { brand } from "../../../data/brand";
import "../../../styles/staff.css";

export const prerender = false;

const { supabase, profile } = Astro.locals;
if (profile!.role !== "manager" && profile!.role !== "server") {
  return Astro.redirect("/staff", 302);
}

const id = Astro.params.id ?? "";
const bill = await getTabBill(supabase, id);
if (!bill) Astro.response.status = 404;

const params = Astro.url.searchParams;
const justClosed = params.get("closed") === "1";
const justMoved = params.get("moved") === "1";
const justMerged = params.get("merged") === "1";
const err = params.get("err");

const pct = (r: number) => `${Math.round(r * 100)}%`;

// A stable, human-readable bill number derived from the tab id.
const billNo = bill
  ? (parseInt(bill.id.replace(/-/g, "").slice(0, 8), 16) % 100000).toString().padStart(5, "0")
  : "";
const servedBy = profile!.name?.trim() || profile!.role;

function stamp(iso: string): { date: string; time: string } {
  try {
    const d = new Date(iso);
    return {
      date: d.toLocaleDateString("en-IN", { day: "2-digit", month: "2-digit", year: "2-digit" }),
      time: d.toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" }),
    };
  } catch {
    return { date: "", time: "" };
  }
}
const when = bill ? stamp(bill.closed_at ?? bill.opened_at) : { date: "", time: "" };
---

<AppLayout title={bill ? `Bill · Table ${bill.table_label} — Berlin` : "Tab not found — Berlin"}>
  <main class="billwrap">
    {!bill ? (
      <p class="billwrap__missing">That tab doesn't exist.</p>
    ) : (
      <>
        <div class="billbar no-print st-rise">
          <a class="st-back" href="/staff/tabs"><span aria-hidden="true">←</span> Open tabs</a>
          <div class="billbar__ops">
            {bill.status === "open" && (
              <form method="post" action={`/api/staff/tabs/${bill.id}/close`}>
                <button type="submit" class="st-btn st-btn--ghost billbar__btn">Close tab · paid</button>
              </form>
            )}
            <button id="print-btn" type="button" class="st-btn st-btn--primary billbar__btn">
              <span>Print bill</span>
              <svg class="st-btn__arrow" width="30" height="8" viewBox="0 0 30 8" fill="none" aria-hidden="true">
                <path d="M0 4h28M28 4l-5-3.25M28 4l-5 3.25" stroke="currentColor" stroke-width="1" stroke-linecap="square" />
              </svg>
            </button>
          </div>
        </div>

        {bill.status === "open" && (
          <div class="ops no-print st-rise-2">
            <form class="ops__form" method="post" action={`/api/staff/tabs/${bill.id}/move`}>
              <span class="ops__label">Move this tab to another table</span>
              <div class="ops__row">
                <label class="st-field ops__field">
                  <input class="st-field__input" name="to" placeholder="e.g. 8" autocomplete="off" aria-label="Move to table" />
                </label>
                <button class="st-btn st-btn--ghost ops__go" type="submit">Move</button>
              </div>
            </form>
            <form class="ops__form" method="post" action={`/api/staff/tabs/${bill.id}/merge`}>
              <span class="ops__label">Merge another table into this bill</span>
              <div class="ops__row">
                <label class="st-field ops__field">
                  <input class="st-field__input" name="from" placeholder="e.g. 6" autocomplete="off" aria-label="Merge from table" />
                </label>
                <button class="st-btn st-btn--ghost ops__go" type="submit">Merge</button>
              </div>
            </form>
          </div>
        )}

        {justClosed && <p class="st-alert st-alert--ok no-print" role="status">Tab closed — marked paid.</p>}
        {justMoved && <p class="st-alert no-print" role="status">Tab moved to Table {bill.table_label}.</p>}
        {justMerged && <p class="st-alert no-print" role="status">Tables merged — the rounds now sit on this bill.</p>}
        {err && <p class="st-alert st-alert--error no-print" role="alert">{err}</p>}

        <div class="receipt-wrap st-rise-2">
          <div class="receipt__perf receipt__perf--top" aria-hidden="true"></div>
          <article class="receipt">
            <header class="receipt__head">
              <p class="receipt__brand">Berlin</p>
              <p class="receipt__subbrand">Haus de Gourmet</p>
              <p class="receipt__addr">{brand.contact.address.line1} · {brand.contact.address.line2}</p>
              <p class="receipt__doc">Tax Invoice</p>
            </header>

            <dl class="receipt__meta">
              <div><dt>Date</dt><dd>{when.date} · {when.time}</dd></div>
              <div><dt>Bill No.</dt><dd>{billNo}</dd></div>
              <div><dt>Table</dt><dd>{bill.table_label}</dd></div>
              <div><dt>Served by</dt><dd>{servedBy}</dd></div>
            </dl>

            <div class="receipt__cols" aria-hidden="true">
              <span>Qty</span>
              <span>Item</span>
              <span>Rate</span>
              <span>Amount</span>
            </div>

            <ul class="receipt__lines">
              {bill.lines.map((line) => (
                <li class="receipt__line">
                  <span class="receipt__q">{line.qty}</span>
                  <span class="receipt__n">{line.name}</span>
                  <span class="receipt__rate">{formatINR(line.price)}</span>
                  <span class="receipt__amt">{formatINR(line.price * line.qty)}</span>
                </li>
              ))}
            </ul>

            <dl class="receipt__totals">
              <div><dt>Sub total</dt><dd>{formatINR(bill.totals.subtotal)}</dd></div>
              <div><dt>Service charge ({pct(SERVICE_RATE)})</dt><dd>{formatINR(bill.totals.service)}</dd></div>
              <div><dt>GST ({pct(GST_RATE)})</dt><dd>{formatINR(bill.totals.gst)}</dd></div>
              <div class="receipt__grand"><dt>Total</dt><dd>{formatINR(bill.totals.total)}</dd></div>
            </dl>

            <footer class="receipt__foot">
              {bill.status === "closed" && <p class="receipt__paid">Paid</p>}
              <p class="receipt__fssai">FSSAI · 115160&#8203;04000575</p>
              <p class="receipt__thanks">
                {bill.round_count} {bill.round_count === 1 ? "round" : "rounds"} · Thank you · Visit again
              </p>
            </footer>
          </article>
          <div class="receipt__perf receipt__perf--bottom" aria-hidden="true"></div>
        </div>
      </>
    )}
  </main>
</AppLayout>

<script>
  document.getElementById("print-btn")?.addEventListener("click", () => window.print());
</script>

<style>
  .billwrap {
    max-width: 30rem;
    margin-inline: auto;
    padding: var(--space-40) var(--gutter) var(--space-96);
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .billwrap__missing {
    padding-block: var(--space-64);
    text-align: center;
    color: var(--text-muted);
  }

  /* --- Top bar + table operations ----------------------------------------- */
  .billbar {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-16);
  }
  .billbar .st-back {
    align-self: flex-start;
  }
  .billbar__ops {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
  }
  .billbar__btn {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding-inline: var(--space-16);
    font-size: var(--fs-label);
  }

  .ops {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-24);
    padding: var(--space-24);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
  }
  .ops__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .ops__label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .ops__row {
    display: flex;
    align-items: flex-end;
    gap: var(--space-12);
  }
  .ops__field {
    flex: 1 1 auto;
  }
  .ops__go {
    flex: 0 0 auto;
    min-height: 2.75rem;
    padding-inline: var(--space-20, 1.25rem);
    font-size: var(--fs-label);
  }

  /* --- The receipt — a Berlin-tailored thermal slip ----------------------- */
  .receipt-wrap {
    align-self: center;
    width: 100%;
    max-width: 23rem;
    filter: drop-shadow(0 24px 44px rgba(0, 0, 0, 0.4));
  }
  .receipt {
    background: var(--color-ivory);
    color: var(--color-warm-black);
    padding: var(--space-32) var(--space-24) var(--space-24);
    font-family: var(--font-ui);
  }
  /* Torn thermal edges, top and bottom. */
  .receipt__perf {
    height: 0.7rem;
    background: var(--color-ivory);
  }
  .receipt__perf--top {
    -webkit-mask: radial-gradient(0.4rem at 50% 0%, transparent 96%, #000) 0 0 / 0.8rem 0.7rem repeat-x;
    mask: radial-gradient(0.4rem at 50% 0%, transparent 96%, #000) 0 0 / 0.8rem 0.7rem repeat-x;
  }
  .receipt__perf--bottom {
    -webkit-mask: radial-gradient(0.4rem at 50% 100%, transparent 96%, #000) 0 100% / 0.8rem 0.7rem repeat-x;
    mask: radial-gradient(0.4rem at 50% 100%, transparent 96%, #000) 0 100% / 0.8rem 0.7rem repeat-x;
  }

  .receipt__head {
    text-align: center;
    padding-block-end: var(--space-16);
    border-bottom: 1px dashed #9a9184;
  }
  .receipt__brand {
    font-family: var(--font-display);
    font-size: var(--fs-heading-m);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-warm-black);
  }
  .receipt__subbrand {
    margin-block-start: var(--space-4);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: #5b544a;
  }
  .receipt__addr {
    margin: var(--space-12) auto 0;
    max-width: 16rem;
    font-size: var(--fs-caption);
    line-height: 1.5;
    color: #5b544a;
  }
  .receipt__doc {
    margin-block-start: var(--space-12);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-champagne-muted);
  }

  .receipt__meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8) var(--space-16);
    padding-block: var(--space-16);
    border-bottom: 1px dashed #9a9184;
  }
  .receipt__meta div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .receipt__meta dt {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: #8a8172;
  }
  .receipt__meta dd {
    font-size: var(--fs-caption);
    color: var(--color-warm-black);
    font-variant-numeric: tabular-nums;
  }

  .receipt__cols {
    display: grid;
    grid-template-columns: 2.2rem 1fr auto auto;
    gap: var(--space-12);
    padding-block: var(--space-12) var(--space-8);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: #8a8172;
  }
  .receipt__cols span:nth-child(3),
  .receipt__cols span:nth-child(4) {
    text-align: end;
    min-width: 3.5rem;
  }
  .receipt__lines {
    display: flex;
    flex-direction: column;
  }
  .receipt__line {
    display: grid;
    grid-template-columns: 2.2rem 1fr auto auto;
    gap: var(--space-12);
    align-items: baseline;
    padding-block: var(--space-8);
    border-bottom: 1px solid #e0d8c8;
    font-size: var(--fs-body);
  }
  .receipt__q {
    font-variant-numeric: tabular-nums;
    color: #5b544a;
  }
  .receipt__n {
    min-width: 0;
    color: var(--color-warm-black);
  }
  .receipt__rate,
  .receipt__amt {
    text-align: end;
    min-width: 3.5rem;
    font-variant-numeric: tabular-nums;
  }
  .receipt__rate {
    color: #5b544a;
  }
  .receipt__amt {
    color: var(--color-warm-black);
  }

  .receipt__totals {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-block: var(--space-16);
    border-top: 1px dashed #9a9184;
  }
  .receipt__totals > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-16);
    font-size: var(--fs-caption);
  }
  .receipt__totals dt {
    color: #5b544a;
  }
  .receipt__totals dd {
    font-variant-numeric: tabular-nums;
    color: var(--color-warm-black);
  }
  .receipt__grand {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-12);
    border-top: 1px solid #9a9184;
    align-items: baseline;
  }
  .receipt__grand dt {
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
    color: var(--color-warm-black) !important;
  }
  .receipt__grand dd {
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
  }

  .receipt__foot {
    text-align: center;
    padding-block-start: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .receipt__paid {
    align-self: center;
    padding: var(--space-4) var(--space-16);
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #4c8b4a;
    border: 1px solid #4c8b4a;
  }
  .receipt__fssai {
    font-size: 0.6rem;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: #8a8172;
    font-variant-numeric: tabular-nums;
  }
  .receipt__thanks {
    font-size: var(--fs-caption);
    color: #5b544a;
  }

  @media (max-width: 32rem) {
    .ops {
      grid-template-columns: 1fr;
    }
  }

  /* Print the receipt exactly as shown, on a receipt-width roll — not stretched
     across an A4 sheet. The 80mm page + auto height matches a thermal printer. */
  @media print {
    @page {
      size: 80mm auto;
      margin: 3mm;
    }
    :global(html),
    :global(body) {
      background: var(--color-ivory) !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .billwrap {
      max-width: none;
      padding: 0;
      gap: 0;
    }
    .no-print {
      display: none !important;
    }
    .receipt-wrap {
      max-width: none;
      width: 100%;
      align-self: stretch;
      filter: none;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .receipt {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
      padding: var(--space-16) var(--space-12);
    }
  }
</style>
