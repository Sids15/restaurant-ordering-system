---
/**
 * Open tabs (Feature: billing). The floor as a ledger — every table with an open
 * tab, its rounds and running total, so a server can pull up a collective bill.
 * Behind the auth middleware; billing is for roles that take orders.
 */
import AppLayout from "../../../layouts/AppLayout.astro";
import StationMasthead from "../../../components/staff/StationMasthead.astro";
import StationShell from "../../../components/staff/StationShell.astro";
import { getOpenTabs } from "../../../lib/orders/tabs";
import { assigneeName } from "../../../lib/orders/assign";
import { formatINR } from "../../../lib/money";
import { brand } from "../../../data/brand";
import "../../../styles/staff.css";

export const prerender = false;

const { supabase, profile } = Astro.locals;
if (profile!.role !== "manager" && profile!.role !== "server") {
  return Astro.redirect("/staff", 302);
}

const tabs = await getOpenTabs(supabase);
const floorTotal = tabs.reduce((s, t) => s + t.subtotal, 0);

function when(iso: string): string {
  try {
    return new Date(iso).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" });
  } catch {
    return "";
  }
}
---

<AppLayout title={`Open tabs — ${brand.name}`}>
  <StationShell role={profile!.role} name={profile!.name} pathname={Astro.url.pathname} variant="tabs">
    <StationMasthead title="Open tabs" />

    {tabs.length === 0 ? (
      <p class="st-empty st-rise-2">No open tabs. A tab opens when a table places its first order.</p>
    ) : (
      <>
        <p class="tabs__summary st-rise-2">
          <span class="tabs__stat"><strong>{tabs.length}</strong> {tabs.length === 1 ? "table" : "tables"} open</span>
          <span class="tabs__dot" aria-hidden="true">·</span>
          <span class="tabs__stat"><strong class="tabs__amt">{formatINR(floorTotal)}</strong> running on the floor</span>
        </p>

        <ul class="ledger st-rise-2">
          {tabs.map((t) => (
            <li class="ledger__row">
              <a class="ledger__link" href={`/staff/tabs/${t.id}`}>
                <span class="ledger__table"><span class="ledger__word">Table</span> {t.table_label}</span>
                {t.assigned ? (
                  <span class="pill pill--accent ledger__server">{assigneeName(t.assigned)}</span>
                ) : (
                  <span class="pill pill--empty ledger__server">Unassigned</span>
                )}
                <span class="ledger__meta">
                  {t.order_count} {t.order_count === 1 ? "round" : "rounds"} · since {when(t.opened_at)}
                </span>
                <span class="ledger__total">{formatINR(t.subtotal)}</span>
                <svg class="ledger__go" width="28" height="8" viewBox="0 0 28 8" fill="none" aria-hidden="true">
                  <path d="M0 4h26M26 4l-5-3.25M26 4l-5 3.25" stroke="currentColor" stroke-width="1" stroke-linecap="square" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </StationShell>
</AppLayout>

<style>
  .tabs__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-8) var(--space-12);
    max-width: none;
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .tabs__stat strong {
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .tabs__amt {
    color: var(--accent) !important;
  }
  .tabs__dot {
    color: var(--border-strong);
  }

  /* --- The ledger ----------------------------------------------------------- */
  .ledger {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .ledger__link {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    padding: var(--space-24);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    color: var(--ink);
    transition: box-shadow var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .ledger__link:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--accent);
  }
  .ledger__table {
    flex: 0 0 auto;
    margin-inline-end: var(--space-24);
    font-family: var(--font-display);
    font-size: var(--fs-heading-l);
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .ledger__word {
    margin-inline-end: var(--space-8);
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  /* Who's on the table. Sits beside the number because that pairing is the
     whole point of the list; the chip is quiet enough not to compete with it. */
  .ledger__server {
    align-self: center;
    margin-inline-end: var(--space-16);
  }

  .ledger__meta {
    flex: 1 1 auto;
    font-size: var(--fs-caption);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .ledger__total {
    flex: 0 0 auto;
    margin-inline-start: var(--space-24);
    font-family: var(--font-display);
    font-size: var(--fs-heading-m);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }
  .ledger__go {
    flex: 0 0 auto;
    align-self: center;
    margin-inline-start: var(--space-16);
    color: var(--ink-muted);
    transition: transform var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .ledger__link:hover .ledger__go {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 36rem) {
    .ledger__meta {
      flex-basis: 100%;
      order: 3;
      margin-block-start: var(--space-8);
    }
    .ledger__total {
      margin-inline-start: auto;
    }
    .ledger__go {
      display: none;
    }
  }
</style>
