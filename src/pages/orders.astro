---
/**
 * Your table this visit (customer). Every round the guest's device has ordered
 * on its current open tab, with a running total. Access rides on the session
 * cookie: currentSession() only resolves while the tab is open, so the moment a
 * server closes (or merges) the tab the token is cleared and this history goes
 * away for the guest — the underlying orders are kept for the staff bill.
 */
import AppLayout from "../layouts/AppLayout.astro";
import { currentSession } from "../lib/orders/session";
import { getSessionOrders, type CustomerOrderState } from "../lib/orders/track";
import { formatINR } from "../lib/money";
import { brand } from "../data/brand";

export const prerender = false;

const session = await currentSession(Astro.cookies);
const rounds = session ? await getSessionOrders(session.tabId) : [];
const runningTotal = rounds
  .filter((r) => r.state !== "cancelled")
  .reduce((s, r) => s + r.subtotal, 0);

const STATUS: Record<CustomerOrderState, { label: string; tone: string }> = {
  waiting: { label: "Waiting for a server", tone: "pending" },
  placed: { label: "Order placed", tone: "confirmed" },
  cancelled: { label: "Cancelled", tone: "cancelled" },
};

function at(iso: string): string {
  try {
    return new Date(iso).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" });
  } catch {
    return "";
  }
}
---

<AppLayout title={`Your table — ${brand.name}`}>
  {!session ? (
    <main class="hist hist--ended">
      <header class="hist__head">
        <p class="hist__eyebrow">{brand.name}</p>
        <h1 class="hist__title">Session closed</h1>
        <p class="hist__sub">Your table's bill has been settled, so this history is closed.</p>
      </header>
      <p class="hist__ended-note">
        Thank you for dining with us. To order again, scan the code at your table.
      </p>
      <a class="hist__link" href="/menu">
        <span>Back to the menu</span>
        <svg width="30" height="8" viewBox="0 0 30 8" fill="none" aria-hidden="true">
          <path d="M0 4h28M28 4l-5-3.25M28 4l-5 3.25" stroke="currentColor" stroke-width="1" stroke-linecap="square" />
        </svg>
      </a>
    </main>
  ) : (
    <main class="hist">
      <header class="hist__head">
        <p class="hist__eyebrow">{brand.name}</p>
        <h1 class="hist__title">Your table</h1>
        <p class="hist__sub">Everything you've ordered this visit, in one place.</p>
        <p class="hist__table">Table {session.table_label}</p>
      </header>

      {rounds.length === 0 ? (
        <p class="hist__empty">
          Nothing ordered yet. Browse the menu and your rounds will appear here.
        </p>
      ) : (
        <>
          <section class="running" aria-label="Running total">
            <div class="running__row">
              <span class="running__label">Running total</span>
              <span class="running__amt">{formatINR(runningTotal)}</span>
            </div>
            <p class="running__note">
              {rounds.length} {rounds.length === 1 ? "round" : "rounds"} · kept until your bill is settled
            </p>
          </section>

          <ol class="rounds">
            {rounds.map((r, i) => (
              <li class={`round round--${STATUS[r.state].tone}`}>
                <header class="round__head">
                  <div>
                    <p class="round__no">Round {rounds.length - i}</p>
                    <p class="round__meta">{r.code} · {at(r.created_at)}</p>
                  </div>
                  <span class={`round__status round__status--${STATUS[r.state].tone}`}>
                    {STATUS[r.state].label}
                  </span>
                </header>

                <ul class="round__lines">
                  {r.items.map((line) => (
                    <li class="round__line">
                      <span class="round__qty">{line.qty}×</span>
                      <span class="round__name">{line.name}</span>
                      <span class="round__price">{formatINR(line.price * line.qty)}</span>
                    </li>
                  ))}
                </ul>

                <div class="round__foot">
                  <span class="round__subl">Subtotal</span>
                  <span class="round__subv">{formatINR(r.subtotal)}</span>
                  <a class="round__track" href={`/order/${r.code}`}>Track this round →</a>
                </div>
              </li>
            ))}
          </ol>

          <a class="hist__link" href={`/menu/${encodeURIComponent(session.table_label)}`}>
            <span>Order something more</span>
            <svg width="30" height="8" viewBox="0 0 30 8" fill="none" aria-hidden="true">
              <path d="M0 4h28M28 4l-5-3.25M28 4l-5 3.25" stroke="currentColor" stroke-width="1" stroke-linecap="square" />
            </svg>
          </a>
        </>
      )}
    </main>
  )}
</AppLayout>

<style>
  .hist {
    max-width: var(--container-md);
    margin-inline: auto;
    padding: clamp(var(--space-40), 8vw, var(--space-64)) var(--gutter) var(--space-64);
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .hist--ended {
    min-height: 100svh;
    justify-content: center;
    text-align: center;
    gap: var(--space-16);
  }

  /* --- Header --------------------------------------------------------------- */
  .hist__head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hist__eyebrow {
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .hist__title {
    margin-block-start: var(--space-8);
    font-family: var(--font-display);
    font-size: var(--fs-display-l);
    color: var(--ink);
  }
  .hist__sub {
    margin: var(--space-8) auto 0;
    max-width: 24rem;
    color: var(--ink-muted);
  }
  .hist__table {
    display: inline-flex;
    margin-block-start: var(--space-16);
    padding: var(--space-4) var(--space-12);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius-pill);
  }
  .hist__ended-note {
    margin-inline: auto;
    color: var(--ink-muted);
  }

  /* --- Running total ---------------------------------------------------------- */
  .running {
    padding: var(--space-24);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-inline-start: 3px solid var(--accent);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .running__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-16);
  }
  .running__label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .running__amt {
    font-family: var(--font-display);
    font-size: var(--fs-heading-l);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .running__note {
    margin-block-start: var(--space-8);
    max-width: none;
    font-size: var(--fs-caption);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  /* --- Rounds ------------------------------------------------------------------ */
  .rounds {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }
  .round {
    padding: var(--space-24);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-top: 3px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }
  .round--pending {
    border-top-color: var(--status-pending);
  }
  .round--confirmed {
    border-top-color: var(--status-confirmed);
  }
  .round--cancelled {
    opacity: 0.7;
    border-top-color: var(--danger);
  }
  .round__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-16);
    padding-block-end: var(--space-16);
    border-bottom: 1px dashed var(--border);
  }
  .round__no {
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
    color: var(--ink);
  }
  .round__meta {
    margin-block-start: var(--space-4);
    font-size: var(--fs-caption);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .round__status {
    flex: 0 0 auto;
    padding: var(--space-4) var(--space-12);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .round__status--pending {
    color: var(--status-pending);
    background: var(--status-pending-soft);
  }
  .round__status--confirmed {
    color: var(--status-confirmed);
    background: var(--status-confirmed-soft);
  }
  .round__status--cancelled {
    color: var(--danger);
    background: var(--danger-soft);
  }
  .round__lines {
    display: flex;
    flex-direction: column;
  }
  .round__line {
    display: flex;
    align-items: baseline;
    gap: var(--space-16);
    padding-block: var(--space-12);
    border-bottom: 1px solid var(--border);
  }
  .round__qty {
    flex: 0 0 auto;
    min-width: 2ch;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .round__name {
    flex: 1 1 auto;
    color: var(--ink);
  }
  .round__price {
    flex: 0 0 auto;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .round__foot {
    display: flex;
    align-items: baseline;
    gap: var(--space-12);
  }
  .round__subl {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .round__subv {
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .round__track {
    margin-inline-start: auto;
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--border-strong);
    padding-block-end: 2px;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .round__track:hover {
    color: var(--ink);
    border-color: var(--accent);
  }

  .hist__empty {
    margin-inline: auto;
    padding-block: var(--space-40);
    text-align: center;
    color: var(--ink-muted);
  }

  .hist__link {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: var(--space-12);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--border-strong);
    padding-block-end: var(--space-4);
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .hist__link svg {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .hist__link:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
  .hist__link:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 30rem) {
    .round__foot {
      flex-wrap: wrap;
    }
    .round__track {
      flex-basis: 100%;
      margin-inline-start: 0;
      margin-block-start: var(--space-8);
    }
  }
</style>
