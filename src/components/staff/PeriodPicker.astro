---
/**
 * PeriodPicker — the step arrows and calendar that choose what a back-of-house
 * page reports on. Shared by the day view and analytics, so both read the same
 * URL grammar and behave identically (lib/orders/period.ts).
 *
 * A <details> popover, deliberately: month paging and range selection are plain
 * links carrying state in the query string, so the whole control — including
 * two-click range selection — works with JavaScript switched off. The script
 * at the bottom only adds click-away and Escape.
 *
 * Each square carries a dot when that day took money. Presence, not amount:
 * forty-two squares of currency is a wall, so the figure is on the label.
 */
import { dayLabel, monthLabel, monthGrid, shiftMonth } from "../../lib/orders/day";
import type { PeriodSelection } from "../../lib/orders/period";
import type { DayActivity } from "../../lib/orders/manager";
import { formatINR } from "../../lib/money";

interface Props {
  sel: PeriodSelection;
  /** Takings per day for the month on screen, keyed YYYY-MM-DD. */
  activity: Map<string, DayActivity>;
  /** Where "Jump to today" and the mode switch point. */
  basePath: string;
}
const { sel, activity, basePath } = Astro.props;

const cells = monthGrid(sel.viewMonth);
const WEEKDAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const nextMonthBlocked = sel.viewMonth >= sel.thisMonth;
---

<div class="daynav">
  <a class="daynav__step" href={sel.prevHref} rel="prev">
    <span aria-hidden="true">←</span>
    <span class="visually-hidden">Earlier</span>
  </a>

  <details class="cal" open={Boolean(Astro.url.searchParams.get("month")) || Boolean(sel.pendingFrom)}>
    <summary class="cal__toggle">
      <span>
        {sel.pendingFrom ? "Pick the other day" : sel.isRange ? "Change range" : "Pick a day"}
      </span>
      <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
        <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </summary>

    <div class="cal__pop">
      <div class="cal__head">
        <a class="cal__month-step" href={sel.monthHref(shiftMonth(sel.viewMonth, -1))}>
          <span aria-hidden="true">←</span>
          <span class="visually-hidden">Previous month</span>
        </a>
        <span class="cal__month">{monthLabel(sel.viewMonth)}</span>
        <a
          class="cal__month-step"
          href={nextMonthBlocked ? undefined : sel.monthHref(shiftMonth(sel.viewMonth, 1))}
          aria-disabled={nextMonthBlocked ? "true" : undefined}
        >
          <span aria-hidden="true">→</span>
          <span class="visually-hidden">Next month</span>
        </a>
      </div>

      <div class="cal__grid" role="presentation">
        {WEEKDAYS.map((d) => <span class="cal__dow">{d}</span>)}
        {
          cells.map((c) => {
            const took = activity.get(c.key);
            const money = took
              ? `${formatINR(took.takings)} from ${took.orders} ${took.orders === 1 ? "order" : "orders"}`
              : "nothing taken";
            const title = `${dayLabel(c.key)} — ${money}`;
            const isEnd = c.key === sel.from || c.key === sel.to || c.key === sel.pendingFrom;
            const inSpan = !isEnd && c.key > sel.from && c.key < sel.to;
            return c.future ? (
              <span class="cal__day cal__day--off" aria-hidden="true">{c.day}</span>
            ) : (
              <a
                class:list={[
                  "cal__day",
                  !c.inMonth && "cal__day--outside",
                  c.today && "cal__day--today",
                  inSpan && "cal__day--span",
                  isEnd && "cal__day--on",
                ]}
                href={sel.dayHref(c.key)}
                aria-current={isEnd ? "date" : undefined}
                aria-label={sel.pendingFrom ? `End the range on ${title}` : title}
                title={title}
              >
                {c.day}
                {took && <span class="cal__dot" aria-hidden="true"></span>}
              </a>
            );
          })
        }
      </div>

      <div class="cal__foot">
        {
          sel.pendingFrom ? (
            <p class="cal__hint">
              From <strong>{dayLabel(sel.pendingFrom)}</strong> — now pick the other end.
              <a href={`${basePath}?date=${sel.pendingFrom}`}>Cancel</a>
            </p>
          ) : (
            <>
              <div class="cal__presets">
                {sel.presets.map((r) => (
                  <a class="cal__preset" href={`${basePath}?from=${r.from}&to=${r.to}`}>
                    {r.label}
                  </a>
                ))}
              </div>
              <div class="cal__modes">
                <a class="cal__jump" href={basePath}>Jump to today</a>
                <a class="cal__jump" href={`${basePath}?pick=range&month=${sel.viewMonth}`}>
                  Pick a range
                </a>
              </div>
            </>
          )
        }
      </div>
    </div>
  </details>

  <a
    class="daynav__step"
    href={sel.atEnd ? undefined : sel.nextHref}
    aria-disabled={sel.atEnd ? "true" : undefined}
    rel="next"
  >
    <span aria-hidden="true">→</span>
    <span class="visually-hidden">Later</span>
  </a>
</div>

<script>
  // Progressive enhancement: the picker opens, pages months and selects days
  // with JavaScript off. This only closes it the ways people expect.
  const cal = document.querySelector<HTMLDetailsElement>(".cal");
  if (cal) {
    document.addEventListener("click", (e) => {
      if (cal.open && !cal.contains(e.target as Node)) cal.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && cal.open) {
        cal.open = false;
        cal.querySelector<HTMLElement>(".cal__toggle")?.focus();
      }
    });
  }
</script>

<style>
  .daynav {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
  .daynav__step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: var(--tap);
    padding-inline: var(--space-12);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--ink-muted);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .daynav__step:hover {
    color: var(--ink);
    border-color: var(--ink-muted);
  }
  .daynav__step[aria-disabled="true"] {
    opacity: 0.35;
    pointer-events: none;
  }

  .cal {
    position: relative;
  }
  /* Lift the whole picker, not just its panel, so the open popover clears any
     stacking context a later section might introduce. */
  .cal[open] {
    z-index: var(--z-overlay, 200);
  }
  .cal__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: var(--tap);
    padding-inline: var(--space-16);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .cal__toggle::-webkit-details-marker {
    display: none;
  }
  .cal__toggle:hover {
    color: var(--ink);
    border-color: var(--ink-muted);
  }
  .cal[open] .cal__toggle {
    color: var(--ink);
    border-color: var(--accent);
  }
  .cal__toggle svg {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .cal[open] .cal__toggle svg {
    transform: rotate(180deg);
  }

  .cal__pop {
    position: absolute;
    /* Fallback spelled out: an unresolvable var makes z-index invalid at
       computed-value time, which silently drops it back to auto. */
    z-index: var(--z-overlay, 200);
    inset-block-start: calc(100% + var(--space-8));
    inset-inline-end: 0;
    width: 20rem;
    padding: var(--space-16);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
  }

  .cal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    margin-block-end: var(--space-12);
  }
  .cal__month {
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
    color: var(--ink);
  }
  .cal__month-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    min-height: 2rem;
    border-radius: var(--radius-sm);
    color: var(--ink-muted);
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .cal__month-step:hover {
    color: var(--ink);
    background: var(--surface-sunken);
  }
  .cal__month-step[aria-disabled="true"] {
    opacity: 0.3;
    pointer-events: none;
  }

  .cal__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
  }
  .cal__dow {
    padding-block-end: var(--space-8);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
    text-align: center;
  }
  .cal__day {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
    font-size: var(--fs-caption);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .cal__day:hover {
    background: var(--surface-sunken);
  }
  .cal__day--outside {
    color: var(--ink-muted);
    opacity: 0.55;
  }
  /* Days that haven't happened. Rendered, not omitted, so the grid keeps its
     shape and the week columns stay aligned. */
  .cal__day--off {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    font-size: var(--fs-caption);
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
    opacity: 0.25;
  }
  .cal__day--today {
    font-weight: 700;
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }
  /* Days between the two ends of a chosen range. Tinted, not filled, so the
     endpoints stay the emphasis. */
  .cal__day--span {
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 0;
  }
  .cal__day--on,
  .cal__day--on:hover {
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }
  .cal__dot {
    position: absolute;
    inset-block-end: 4px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
  }
  .cal__day--on .cal__dot {
    background: var(--on-accent);
  }

  .cal__foot {
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-12);
    border-top: 1px solid var(--border);
  }
  .cal__presets {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .cal__preset {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    padding-inline: var(--space-8);
    border-radius: var(--radius-sm);
    font-size: var(--fs-caption);
    color: var(--ink-muted);
    text-align: center;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .cal__preset:hover {
    color: var(--ink);
    background: var(--surface-sunken);
  }
  .cal__modes {
    display: flex;
    justify-content: space-between;
    gap: var(--space-8);
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-8);
    border-top: 1px solid var(--border);
  }
  .cal__jump {
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--accent);
  }
  .cal__hint {
    font-size: var(--fs-caption);
    color: var(--ink-muted);
    text-align: center;
  }
  .cal__hint strong {
    color: var(--ink);
  }
  .cal__hint a {
    display: block;
    margin-block-start: var(--space-8);
    color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 36rem) {
    .cal__pop {
      width: min(20rem, calc(100vw - 2 * var(--gutter)));
    }
  }
</style>
