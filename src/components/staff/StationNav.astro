---
/**
 * StationNav — the persistent back-of-house sidebar. Every station (order desk,
 * order builder, tabs, QR sheet, kitchen, menu manager) is one click away, so
 * staff stop hunting for links that used to live in each page's masthead.
 *
 * The link set carries the role gating that was previously scattered across the
 * masthead `actions` slots: a kitchen login never had a route to the order
 * builder, and that stays true here. Middleware still enforces access — this
 * only decides what's worth showing.
 */
import { brand } from "../../data/brand";
import { roleCanAccess } from "../../lib/auth/access";
import type { Role } from "../../lib/types";

interface Props {
  role: Role;
  name: string;
  /** Astro.url.pathname — used to mark the current station. */
  pathname: string;
  /** Live counts per href, e.g. { "/kitchen": 3 }. Zero and missing both hide. */
  counts?: Record<string, number>;
}
const { role, name, pathname, counts = {} } = Astro.props;

// Filtered through the same roleCanAccess() the middleware enforces with, so
// the rail can never offer a station that bounces you back to the login page.
// A kitchen account sees the board and nothing else; it has no route to the
// order desk, because /staff is server+manager only.
const links = [
  { href: "/staff", label: "Order desk" },
  { href: "/staff/today", label: "Today" },
  { href: "/staff/new", label: "Build order" },
  { href: "/staff/tabs", label: "Open tabs" },
  { href: "/staff/tables", label: "Table QR codes" },
  { href: "/kitchen", label: "Kitchen board" },
  { href: "/admin", label: "Menu manager" },
].filter((l) => roleCanAccess(l.href, role));

// Longest match wins, so /staff/new marks itself rather than also lighting up
// /staff — every station link would otherwise match the order desk's prefix.
const current = links.reduce((best, l) => {
  const hit = pathname === l.href || pathname.startsWith(`${l.href}/`);
  return hit && l.href.length > best.length ? l.href : best;
}, "");

// The seed accounts use the role as the name; showing "kitchen / kitchen"
// twice reads like a bug, so the identity collapses to one line when the name
// says nothing the role doesn't.
const clean = (name ?? "").trim();
const showName = Boolean(clean) && clean.toLowerCase() !== role;
const primary = showName ? clean : role;
const initial = primary.charAt(0).toUpperCase();
---

<aside class="stnav">
  <a class="stnav__brand" href="/staff">
    <span class="stnav__brand-name">{brand.name}</span>
    <span class="stnav__brand-sub">Back of house</span>
  </a>

  <nav class="stnav__links" aria-label="Stations">
    {
      links.map((l) => (
        <a
          class="stnav__link"
          href={l.href}
          aria-current={current === l.href ? "page" : undefined}
        >
          <span>{l.label}</span>
          {counts[l.href] > 0 && (
            <span class="stnav__badge">
              {counts[l.href]}
              <span class="visually-hidden"> waiting</span>
            </span>
          )}
        </a>
      ))
    }
  </nav>

  <div class="stnav__foot">
    <div class="stnav__who" title={showName ? `${primary} · ${role}` : role}>
      <span class="stnav__avatar" aria-hidden="true">{initial}</span>
      <span class="stnav__id">
        <span class="stnav__name">{primary}</span>
        {showName && <span class="stnav__role">{role}</span>}
      </span>
    </div>
    <form class="stnav__out" method="post" action="/api/auth/logout">
      <button class="stnav__signout" type="submit">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path
            d="M5.5 12.5H2.5a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1h3M9 9.5 12 7 9 4.5M12 7H5"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span>Sign out</span>
      </button>
    </form>
  </div>
</aside>
