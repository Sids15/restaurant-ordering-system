# Copy to `.env` (which is gitignored) and fill with your Supabase project values.
# Find these in the Supabase dashboard → Project Settings → API.

# Server only. These are publishable by design (the anon key is guarded by
# Row-Level Security), but nothing in this app reads them from the browser —
# every island talks to our own /api routes. Deliberately NOT `PUBLIC_`-prefixed
# so they can never be inlined into the CLIENT bundle. Note they ARE still
# inlined into the server bundle at build time when set; `serverEnv` falls back
# to process.env at runtime, which is what rescues a var Vercel marks
# "Sensitive" (hidden from the build) or one added after the last deploy.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"

# SECRET — server only. NEVER commit this or expose it to the client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# SECRET — server only. Signs the table QR tokens so a scanned table can't be
# guessed or forged. Must be a long random string (>= 16 chars); generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every previously printed QR code (reprint required).
TABLE_TOKEN_SECRET="a-long-random-server-only-secret"

# Your live customer domain, no trailing slash. Table QR codes encode
# <SITE_URL>/menu/<table>, so setting this makes a printed code identical
# no matter where the sheet is generated (prod, a preview URL, or localhost).
# Leave unset to fall back to the request origin.
SITE_URL="https://your-live-domain.com"
